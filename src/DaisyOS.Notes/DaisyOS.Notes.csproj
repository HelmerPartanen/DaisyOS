<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the existing UI/resources while the app
         gets an independent executable, dispatcher and application lifetime. -->
    <ProjectReference Include="../DaisyOS.Shell/DaisyOS.Shell.csproj" />
  </ItemGroup>
  <PropertyGroup><OptionalApplicationSource>Notes</OptionalApplicationSource></PropertyGroup>
  <Import Project="../DaisyOS.OptionalApplication.targets" />
</Project>
