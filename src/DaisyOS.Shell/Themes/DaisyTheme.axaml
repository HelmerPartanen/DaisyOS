  <x:Double x:Key="WindowCaptionButtonHeight">32</x:Double>
  <!-- KWin owns server-side titlebars. Keep their hit targets generous while
       allowing their visual density to remain calmer than DaisyOS app chrome. -->
  <!-- App dock stays compact; crowded items shrink within this screen-clamped width. -->
