  <SolidColorBrush x:Key="ActionPrimaryInsetBorderBrush" Color="#FFFFFF" Opacity="0.08" />

  <DropShadowEffect x:Key="DesktopLabelShadow" OffsetX="0" OffsetY="1" BlurRadius="2" Color="Black" Opacity="0.65" />
  <DropShadowEffect x:Key="DesktopItemLabelShadow" OffsetX="0" OffsetY="1" BlurRadius="2" Color="Black" Opacity="0.65" />
  <BoxShadows x:Key="ElevationWindowShadow">0 1 5 0 #16000000</BoxShadows>
  <BoxShadows x:Key="ElevationWindowFocusedShadow">0 2 8 0 #3D000000</BoxShadows>
  <BoxShadows x:Key="ElevationFlyoutShadow">0 4 16 0 #30000000</BoxShadows>
  <!-- Translucent shell cards already separate themselves through blur and
       their double frame. Keep their shadow close and restrained so it does
       not turn into a dark halo over the wallpaper. -->
  <BoxShadows x:Key="ElevationShellGlassPanelShadow">0 3 12 0 #24000000</BoxShadows>
  <BoxShadows x:Key="ElevationPopupShadow">0 6 18 0 #38000000</BoxShadows>
  <BoxShadows x:Key="ElevationPanelShadow">0 8 24 0 #60000000</BoxShadows>
  <BoxShadows x:Key="ElevationDialogShadow">0 12 36 0 #80000000</BoxShadows>
  <!-- Floating shell surfaces sit directly over wallpaper and application
       content, so their elevation is intentionally clearer than an in-app
       card. Keep these roles separate from ordinary menus and windows. -->
  <BoxShadows x:Key="ElevationShellChromeShadow">0 8 28 0 #A6000000</BoxShadows>
  <BoxShadows x:Key="ElevationShellPopupShadow">0 12 36 0 #B3000000</BoxShadows>
  <BoxShadows x:Key="ElevationShellDialogShadow">0 16 44 0 #BF000000</BoxShadows>
