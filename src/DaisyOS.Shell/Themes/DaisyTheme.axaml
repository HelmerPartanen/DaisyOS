<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:easings="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base">
  <!--
    DaisyOS semantic theme contract. Components select a role, never a literal
    paint or a desktop-specific palette. Theme-specific values belong
    only in these dictionaries.
  -->
  <!-- Filled destructive actions need a saturated red with readable white content. -->
  <Color x:Key="ActionDangerColor">#FFC92A35</Color>
  <Color x:Key="ActionDangerHoverColor">#FFB8212C</Color>
  <Color x:Key="ActionDangerPressedColor">#FFA51925</Color>
  <SolidColorBrush x:Key="ActionDangerBrush" Color="{StaticResource ActionDangerColor}" />
  <SolidColorBrush x:Key="ActionDangerHoverBrush" Color="{StaticResource ActionDangerHoverColor}" />
  <SolidColorBrush x:Key="ActionDangerPressedBrush" Color="{StaticResource ActionDangerPressedColor}" />
  <!-- Filled destructive surfaces keep white content: the fixed danger red is
       dark enough that the action-content role would drop below 4.5:1. -->
  <SolidColorBrush x:Key="ContentOnDangerBrush" Color="#FFFFFFFF" />
  <!-- Slider thumbs are a control surface, not content, and stay white on the
       accent-filled track. -->
  <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFFFF" />
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <!-- Surfaces -->
    <Color x:Key="SurfaceCanvasColor">#FFF2F2F2</Color>
    <!-- Translucent so KWin's native background effect remains visible. -->
    <Color x:Key="SurfaceBaseColor">#99F2F2F2</Color>
    <Color x:Key="SurfaceBaseColorSolid">#FFF2F2F2</Color>
    <!-- The launcher uses the same dark translucent overlay in both themes. -->
    <Color x:Key="LauncherBackdropColor">#1A000000</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedSubtleColor">#0F000000</Color>
    <Color x:Key="SurfaceInputSubtleColor">#12FFFFFF</Color>
    <Color x:Key="SurfaceOverlayColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceSunkenColor">#FFEDEDEF</Color>
    <Color x:Key="SurfaceInputColor">#FFF1F1F3</Color>
    <Color x:Key="SurfaceInputHoverColor">#FFE9E9EC</Color>
    <!-- Shared elevated glass used by context menus and shell-owned modal panels. -->
    <Color x:Key="RaisedPanelBackgroundColor">#FFF7F7F7</Color>
    <Color x:Key="ContextMenuBackgroundColor">#FFF7F7F7</Color>

    <!-- Content -->
    <Color x:Key="ContentPrimaryColor">#FF000000</Color>
    <Color x:Key="ContentSecondaryColor">#CC000000</Color>
    <Color x:Key="ContentTertiaryColor">#99000000</Color>
    <Color x:Key="ContentDisabledColor">#FFA5A5AA</Color>

    <!-- Strokes -->
    <Color x:Key="StrokeSubtleColor">#FFE4E4E7</Color>
    <Color x:Key="StrokeDefaultColor">#26000000</Color>
    <Color x:Key="StrokeStrongColor">#FFA4A4AB</Color>


           <Color x:Key="RedSwatch">#FF383C</Color>
           <Color x:Key="OrangeSwatch">#FFFF9500</Color>


    <!--
        Large shell surfaces use two distinct perimeter roles.
        Ordinary borders and dividers keep Stroke*.
    -->
      <Color x:Key="ShellFrameOuterEdgeColor">#66000000</Color>
      <Color x:Key="ShellFrameInnerHighlightColor">#99FFFFFF</Color>
    <SolidColorBrush x:Key="ShellSurfaceInnerBorderBrush" Color="{StaticResource ShellFrameInnerHighlightColor}" />

    <!-- Interaction states -->
<Color x:Key="DesktopHoverColor">#33FFFFFF</Color>
<Color x:Key="StatePressedColor">#38000000</Color>
<Color x:Key="StateSelectedColor">#30000000</Color>

    <!-- Overlays -->
    <Color x:Key="OverlayScrimColor">#6608080A</Color>

    <!--
        A restrained concentration edge behind a fullscreen client,
        not a panel background.
    -->
    <Color x:Key="FullscreenBottomScrimColor">#33000000</Color>

    <!-- Primary actions -->
    <Color x:Key="ActionPrimaryColor">#FF1598FF</Color>
    <Color x:Key="ActionPrimaryHoverColor">#FF138CEB</Color>
    <Color x:Key="ActionPrimaryPressedColor">#FF1283DB</Color>
    <!-- Tinted, translucent accent for selected/active surfaces. -->
    <Color x:Key="ActionPrimarySubtleColor">#331598FF</Color>
    <Color x:Key="ContentOnActionColor">#FF111113</Color>
    <Color x:Key="ContentOnPrimaryActionColor">#FFFFFFFF</Color>
    <Color x:Key="QuickSettingActiveSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="QuickSettingActiveSurfaceHoverColor">#FFF6F6F7</Color>
    <Color x:Key="QuickSettingActiveSurfacePressedColor">#FFECECEF</Color>
    <!-- Active quick-setting pairs always sit on the light surface, including in dark mode. -->
    <Color x:Key="QuickSettingActiveDividerColor">#26000000</Color>
    <SolidColorBrush x:Key="QuickSettingActiveDividerBrush" Color="{StaticResource QuickSettingActiveDividerColor}" />

    <!--
        Keep inactive controls visually continuous with taskbar item
        interaction material.
    -->
    <Color x:Key="ActionSecondaryHoverColor">#14000000</Color>
    <Color x:Key="ActionSecondaryPressedColor">#1F000000</Color>
    <Color x:Key="ContentOnSecondaryActionColor">#FF1C1C1F</Color>

    <!-- Focus -->
    <Color x:Key="FocusRingColor">#FF1598FF</Color>

        <Color x:Key="SelectedBlue">#FF1598FF</Color>

    <!-- Status: Success -->
    <Color x:Key="StatusSuccessColor">#FF0E7A38</Color>
    <Color x:Key="StatusSuccessContainerColor">#FFE4F6EA</Color>
    <Color x:Key="BatteryChargingColor">#FF00CA48</Color>

    <!-- Status: Warning -->
    <Color x:Key="StatusWarningColor">#FF8A4B00</Color>
    <Color x:Key="StatusWarningContainerColor">#FFFFF0D5</Color>

    <!-- Status: Danger -->
    <Color x:Key="StatusDangerColor">#FFB4232A</Color>
    <Color x:Key="StatusDangerContainerColor">#FFFFE8E7</Color>

    <!-- Status: Info -->
    <Color x:Key="StatusInfoColor">#FF1E5AA8</Color>
    <Color x:Key="StatusInfoContainerColor">#FFE5F0FF</Color>

<!-- Branding options -->
    <Color x:Key="FaviconColor">#FF1598FF</Color>

    <!-- Accent options -->
    <!-- Saturated decorative accents, tuned for this theme's surfaces. -->
    <Color x:Key="VibrantGreenColor">#FF009A42</Color>
    <Color x:Key="VibrantYellowColor">#FFB47D00</Color>
    <Color x:Key="VibrantRedColor">#FFE62032</Color>
    <Color x:Key="VibrantOrangeColor">#FFDB5500</Color>
    <Color x:Key="AccentOptionDefaultColor">#FF1598FF</Color>
    <Color x:Key="AccentOptionBlueColor">#FF1598FF</Color>
    <Color x:Key="AccentOptionPurpleColor">#FF7652D9</Color>
    <Color x:Key="AccentOptionPinkColor">#FFD94F8D</Color>
    <Color x:Key="AccentOptionRedColor">#FFD84A43</Color>
    <Color x:Key="AccentOptionOrangeColor">#FFD97822</Color>
    <Color x:Key="AccentOptionGreenColor">#FF2B8A52</Color>
    <Color x:Key="AccentOptionGrayColor">#FF777B84</Color>
    <Color x:Key="AccentOptionWhiteColor">#FFFFFFFF</Color>

    <!-- File location colors -->
    <Color x:Key="FileLocationDesktopColor">#FF3478E5</Color>
    <Color x:Key="FileLocationDocumentsColor">#FF68778D</Color>
    <Color x:Key="FileLocationDownloadsColor">#FF1687A5</Color>
    <Color x:Key="FileLocationPicturesColor">#FF3682C7</Color>
    <Color x:Key="FileLocationVideosColor">#FF7652D9</Color>
    <Color x:Key="FileLocationMusicColor">#FFD84A43</Color>

      <SolidColorBrush x:Key="SelectedBlueBrush" Color="{StaticResource SelectedBlue}" />
      <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource SurfaceCanvasColor}" />
      <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" />
      <SolidColorBrush x:Key="SurfaceBaseSolidBrush" Color="{StaticResource SurfaceBaseColorSolid}" />
      <SolidColorBrush x:Key="LauncherBackdropBrush" Color="{StaticResource LauncherBackdropColor}" />
      <SolidColorBrush x:Key="LauncherSolidBackdropBrush" Color="#FF171717" />
      <SolidColorBrush x:Key="LauncherSearchSurfaceBrush" Color="#EBFFFFFF" />
      <SolidColorBrush x:Key="LauncherSearchBorderBrush" Color="#24000000" />
      <SolidColorBrush x:Key="LauncherTileHoverBrush" Color="#12000000" />
      <SolidColorBrush x:Key="LauncherTileSelectedBrush" Color="#241598FF" />
      <SolidColorBrush x:Key="LauncherTileSelectedBorderBrush" Color="#881598FF" />
      <SolidColorBrush x:Key="LauncherDotActiveBrush" Color="{StaticResource ContentPrimaryColor}" />
      <SolidColorBrush x:Key="LauncherDotInactiveBrush" Color="#36000000" />
      <SolidColorBrush x:Key="LauncherKeycapBackgroundBrush" Color="#10000000" />
      <SolidColorBrush x:Key="LauncherUtilitySurfaceBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="SurfaceGlassSolidBrush" Color="{StaticResource RaisedPanelBackgroundColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedSubtleBrush" Color="{StaticResource SurfaceRaisedSubtleColor}" />
      <SolidColorBrush x:Key="SurfaceInputSubtleBrush" Color="{StaticResource SurfaceInputSubtleColor}" />
      <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
      <SolidColorBrush x:Key="SurfaceModalGlassBrush" Color="{StaticResource RaisedPanelBackgroundColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
      <SolidColorBrush x:Key="SearchFieldBackgroundBrush" Color="{StaticResource SurfaceRaisedSubtleColor}" />
      <SolidColorBrush x:Key="SearchFieldHoverBrush" Color="{StaticResource SurfaceRaisedSubtleColor}" />
      <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
      <SolidColorBrush x:Key="SurfaceInputHoverBrush" Color="{StaticResource SurfaceInputHoverColor}" />
      <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="{StaticResource RaisedPanelBackgroundColor}" Opacity="0.6" />
      <SolidColorBrush x:Key="ContentPrimaryBrush" Color="{StaticResource ContentPrimaryColor}" />
      <SolidColorBrush x:Key="ContentSecondaryBrush" Color="{StaticResource ContentSecondaryColor}" />
      <SolidColorBrush x:Key="ContentTertiaryBrush" Color="{StaticResource ContentTertiaryColor}" />
      <SolidColorBrush x:Key="ContentDisabledBrush" Color="{StaticResource ContentDisabledColor}" />
      <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource StrokeSubtleColor}" />
      <SolidColorBrush x:Key="StrokeDefaultBrush" Color="{StaticResource StrokeDefaultColor}" />
      <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
      <SolidColorBrush x:Key="ShellFrameOuterEdgeBrush" Color="{StaticResource ShellFrameOuterEdgeColor}" />
      <SolidColorBrush x:Key="ShellFrameInnerHighlightBrush" Color="{StaticResource ShellFrameInnerHighlightColor}" />
      <!-- Ghost controls and quiet raised surfaces intentionally share one
           interaction layer. Desktop items use DesktopHoverBrush instead. -->
      <SolidColorBrush x:Key="StateHoverBrush" Color="{StaticResource SurfaceRaisedSubtleColor}" />
      <SolidColorBrush x:Key="DesktopHoverBrush" Color="{StaticResource DesktopHoverColor}" />
      <SolidColorBrush x:Key="StatePressedBrush" Color="{StaticResource StatePressedColor}" />
      <SolidColorBrush x:Key="StateSelectedBrush" Color="{StaticResource StateSelectedColor}" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="{StaticResource OverlayScrimColor}" />
      <SolidColorBrush x:Key="FullscreenBottomScrimBrush" Color="{StaticResource FullscreenBottomScrimColor}" />
      <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#FFB6B6B6" />
      <SolidColorBrush x:Key="ActionPrimaryBrush" Color="{StaticResource ActionPrimaryColor}" />
      <SolidColorBrush x:Key="ActionPrimarySubtleBrush" Color="{StaticResource ActionPrimarySubtleColor}" />
      <!-- Storage capacity segments: soft blue and quiet neutral fills. -->
      <SolidColorBrush x:Key="StorageUsedBrush" Color="#2997E8" />
      <SolidColorBrush x:Key="StorageOtherVolumesBrush" Color="#A5ACB8" />
      <SolidColorBrush x:Key="StorageReservedBrush" Color="#BEC6D2" />
      <SolidColorBrush x:Key="StorageUnknownBrush" Color="#C8CED7" />
      <SolidColorBrush x:Key="StorageFreeBrush" Color="#DCE2E9" />
      <SolidColorBrush x:Key="StorageUnallocatedBrush" Color="#E9EDF2" />

      <SolidColorBrush x:Key="ActionPrimaryHoverBrush" Color="{StaticResource ActionPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ActionPrimaryPressedBrush" Color="{StaticResource ActionPrimaryPressedColor}" />
      <SolidColorBrush x:Key="ContentOnActionBrush" Color="{StaticResource ContentOnActionColor}" />
      <SolidColorBrush x:Key="ContentOnPrimaryActionBrush" Color="{StaticResource ContentOnPrimaryActionColor}" />
      <SolidColorBrush x:Key="QuickSettingActiveSurfaceBrush" Color="{StaticResource QuickSettingActiveSurfaceColor}" />
      <SolidColorBrush x:Key="QuickSettingActiveSurfaceHoverBrush" Color="{StaticResource QuickSettingActiveSurfaceHoverColor}" />
      <SolidColorBrush x:Key="QuickSettingActiveSurfacePressedBrush" Color="{StaticResource QuickSettingActiveSurfacePressedColor}" />
      <SolidColorBrush x:Key="ActionSecondaryBrush" Color="{StaticResource SurfaceRaisedSubtleColor}" />
      <SolidColorBrush x:Key="ActionSecondaryHoverBrush" Color="{StaticResource ActionSecondaryHoverColor}" />
      <SolidColorBrush x:Key="ActionSecondaryPressedBrush" Color="{StaticResource ActionSecondaryPressedColor}" />
      <SolidColorBrush x:Key="ContentOnSecondaryActionBrush" Color="{StaticResource ContentOnSecondaryActionColor}" />
      <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
      <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
      <SolidColorBrush x:Key="StatusSuccessContainerBrush" Color="{StaticResource StatusSuccessContainerColor}" />
      <SolidColorBrush x:Key="BatteryChargingBrush" Color="{StaticResource BatteryChargingColor}" />
      <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
      <SolidColorBrush x:Key="StatusWarningContainerBrush" Color="{StaticResource StatusWarningContainerColor}" />
      <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
      <SolidColorBrush x:Key="StatusDangerContainerBrush" Color="{StaticResource StatusDangerContainerColor}" />
      <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
      <SolidColorBrush x:Key="StatusInfoContainerBrush" Color="{StaticResource StatusInfoContainerColor}" />
      <SolidColorBrush x:Key="VibrantGreenBrush" Color="{StaticResource VibrantGreenColor}" />
      <SolidColorBrush x:Key="VibrantYellowBrush" Color="{StaticResource VibrantYellowColor}" />
      <SolidColorBrush x:Key="VibrantRedBrush" Color="{StaticResource VibrantRedColor}" />
      <SolidColorBrush x:Key="VibrantOrangeBrush" Color="{StaticResource VibrantOrangeColor}" />
      <SolidColorBrush x:Key="AccentOptionDefaultBrush" Color="{StaticResource AccentOptionDefaultColor}" />
      <SolidColorBrush x:Key="AccentOptionBlueBrush" Color="{StaticResource AccentOptionBlueColor}" />
      <SolidColorBrush x:Key="AccentOptionPurpleBrush" Color="{StaticResource AccentOptionPurpleColor}" />
      <SolidColorBrush x:Key="AccentOptionPinkBrush" Color="{StaticResource AccentOptionPinkColor}" />
      <SolidColorBrush x:Key="AccentOptionRedBrush" Color="{StaticResource AccentOptionRedColor}" />
      <SolidColorBrush x:Key="AccentOptionOrangeBrush" Color="{StaticResource AccentOptionOrangeColor}" />
      <SolidColorBrush x:Key="AccentOptionGreenBrush" Color="{StaticResource AccentOptionGreenColor}" />
      <SolidColorBrush x:Key="AccentOptionGrayBrush" Color="{StaticResource AccentOptionGrayColor}" />
      <SolidColorBrush x:Key="AccentOptionWhiteBrush" Color="{StaticResource AccentOptionWhiteColor}" />
      <SolidColorBrush x:Key="FileLocationDesktopBrush" Color="{StaticResource FileLocationDesktopColor}" />
      <SolidColorBrush x:Key="FileLocationDocumentsBrush" Color="{StaticResource FileLocationDocumentsColor}" />
      <SolidColorBrush x:Key="FileLocationDownloadsBrush" Color="{StaticResource FileLocationDownloadsColor}" />
      <SolidColorBrush x:Key="FileLocationPicturesBrush" Color="{StaticResource FileLocationPicturesColor}" />
      <SolidColorBrush x:Key="FileLocationVideosBrush" Color="{StaticResource FileLocationVideosColor}" />
      <SolidColorBrush x:Key="FileLocationMusicBrush" Color="{StaticResource FileLocationMusicColor}" />
      <SolidColorBrush x:Key="DesktopLabelBrush" Color="{StaticResource ContentPrimaryColor}" />
      <SolidColorBrush x:Key="DesktopItemLabelBrush" Color="{StaticResource ContentPrimaryColor}" />
      <SolidColorBrush x:Key="RedSwatchBrush" Color="{StaticResource RedSwatch}" />
      <SolidColorBrush x:Key="OrangeSwatchBrush" Color="{StaticResource OrangeSwatch}" />
      <SolidColorBrush x:Key="ClockDialBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ClockForegroundBrush" Color="#FF000000" />
      <LinearGradientBrush x:Key="CalendarBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#FFF0F0F0" />
      </LinearGradientBrush>
      <!-- Theme App and Trash Icons -->
      <Bitmap x:Key="AppIconCalculator">avares://DaisyOS.Shell/Assets/AppIcons/Calculator.png</Bitmap>
      <SolidColorBrush x:Key="CalendarTodayBackgroundBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="CalendarTodayForegroundBrush" Color="#FFFFFFFF" />
      <Bitmap x:Key="AppIconFiles">avares://DaisyOS.Shell/Assets/AppIcons/Files.png</Bitmap>
      <Bitmap x:Key="AppIconLauncher">avares://DaisyOS.Shell/Assets/AppIcons/Launcher.png</Bitmap>
      <Bitmap x:Key="AppIconMail">avares://DaisyOS.Shell/Assets/AppIcons/Mail.png</Bitmap>
      <Bitmap x:Key="AppIconNotes">avares://DaisyOS.Shell/Assets/AppIcons/Notes.png</Bitmap>
      <Bitmap x:Key="AppIconDiskManager">avares://DaisyOS.Shell/Assets/AppIcons/Disk_Manager_Light.png</Bitmap>
      <Bitmap x:Key="AppIconAppInstaller">avares://DaisyOS.Shell/Assets/AppIcons/AppInstaller.png</Bitmap>
      <Bitmap x:Key="AppIconSystemMonitor">avares://DaisyOS.Shell/Assets/AppIcons/System_Monitor_Light.png</Bitmap>
      <Bitmap x:Key="AppIconSettings">avares://DaisyOS.Shell/Assets/AppIcons/Settings.png</Bitmap>
      <Bitmap x:Key="AppIconStore">avares://DaisyOS.Shell/Assets/AppIcons/Store.png</Bitmap>
      <Bitmap x:Key="AppIconUiKit">avares://DaisyOS.Shell/Assets/AppIcons/UiKit.png</Bitmap>
      <Bitmap x:Key="AppIconTrash">avares://DaisyOS.Shell/Assets/AppIcons/Trash_Light.png</Bitmap>
      <Bitmap x:Key="AppIconTrashItem">avares://DaisyOS.Shell/Assets/AppIcons/Trash_Item_Light.png</Bitmap>
    </ResourceDictionary>



    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SurfaceCanvasColor">#FF171717</Color>
      <Color x:Key="SurfaceBaseColor">#66000000</Color>
    <Color x:Key="SurfaceBaseColorSolid">#FF171717</Color>
      <!-- Fullscreen launcher glass. See the light theme for the contract. -->
      <Color x:Key="LauncherBackdropColor">#1A000000</Color>
      <Color x:Key="SurfaceRaisedColor">#26FFFFFF</Color>
      <Color x:Key="SurfaceRaisedSubtleColor">#14FFFFFF</Color>
      <Color x:Key="SurfaceInputSubtleColor">#0FFFFFFF</Color>
      <Color x:Key="SurfaceOverlayColor">#FF292929</Color>
      <Color x:Key="SurfaceSunkenColor">#FF111111</Color>
      <Color x:Key="SurfaceInputColor">#FF242424</Color>
      <Color x:Key="SurfaceInputHoverColor">#FF2B2B2B</Color>
