<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">
      <ControlTheme x:Key="{x:Type controls:WidgetContainer}" TargetType="controls:WidgetContainer">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="OuterFrame"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                    CornerRadius="{DynamicResource RoundedXXL}">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="QuadraticEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationSlow}" Easing="{StaticResource MotionEaseMove}" />
                </Transitions>
              </Border.Transitions>
              <Panel>
                <Border Name="InnerSurface"
                        Margin="{DynamicResource ShellFrameSurfaceInset}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource RoundedXXLDoubleInset}"
                        ClipToBounds="True">
                  <ContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <Border Background="Transparent"
                        BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}"
                        BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                        CornerRadius="{DynamicResource RoundedXXLInset}"
                        IsHitTestVisible="False" />
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
</ResourceDictionary>
