<Window x:Class="DaisyOS.Shell.Apps.AppInstaller.AppInstallerWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
        xmlns:installer="clr-namespace:DaisyOS.Shell.Apps.AppInstaller"
        Title="{DynamicResource Loc_569CA49F4AAF}"
        Width="680" Height="480" MinWidth="540" MinHeight="400"
        CanResize="True" WindowStartupLocation="CenterScreen" WindowDecorations="None"
        Classes="SidebarAppWindow" TextOptions.TextRenderingMode="Antialias"
        Background="{DynamicResource SurfaceBaseSolidBrush}">
  <Window.Styles>
    <Style Selector="Border.InstallerCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
    </Style>
    <Style Selector="Button.Pill">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButtonSmall}" />
      <Setter Property="Padding" Value="24,8" />
      <Setter Property="Height" Value="36" />
    </Style>
  </Window.Styles>
  <Grid x:Name="MainPaneLayout" RowDefinitions="Auto,*" Background="{DynamicResource SurfaceBaseSolidBrush}">
    <controls:AppWindowTitleBar x:Name="AppTitleBar" />
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
      <!-- Header: Install -->
      <TextBlock Text="{DynamicResource Loc_569CA49F4AAF}"
                 FontSize="{DynamicResource TypeSizeHeading}" FontWeight="SemiBold"
                 Margin="36,20,36,0" />

      <!-- Center Content -->
      <Grid Grid.Row="1" Margin="36,12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <!-- When file selected (Normal flow) -->
        <StackPanel IsVisible="{Binding HasSelection}" Spacing="{DynamicResource Space4}">
          <Border Classes="InstallerCard" Padding="20">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Width="68" Height="68" CornerRadius="{DynamicResource RadiusControlInner}" ClipToBounds="True"
                      Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center">
                <Panel>
                  <Image Source="{Binding SelectedIcon}" IsVisible="{Binding HasSelectedIcon}" Stretch="Uniform" />
                  <controls:DaisyIcon Icon="package" Size="{DynamicResource IconSizeHero}"
                                      IsVisible="{Binding !HasSelectedIcon}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource ContentSecondaryBrush}" />
                </Panel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedName}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedDetails}" Classes="Muted" FontSize="{DynamicResource TypeSizeBodySmall}" />
                <TextBlock Text="{Binding SelectedComment}" IsVisible="{Binding HasSelectedComment}" Classes="Muted" FontSize="{DynamicResource TypeSizeBodySmall}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedPath}" Classes="Muted" FontSize="{DynamicResource TypeSizeMicro}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPath}" />
              </StackPanel>
            </Grid>
          </Border>

          <ComboBox IsVisible="{Binding CanChooseCompatibilityImage}" IsEnabled="{Binding !IsBusy}"
                    ItemsSource="{Binding CompatibilityImages}" SelectedItem="{Binding CompatibilityImage, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

          <!-- Destination location pill -->
          <Border Background="{DynamicResource SurfaceRaisedSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="{DynamicResource BorderThicknessDefault}"
                  CornerRadius="{DynamicResource RadiusPill}" Padding="16,4,6,4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding InstallDestinationPath}" VerticalAlignment="Center"
                         Classes="Muted" FontSize="{DynamicResource TypeSizeBodySmall}"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InstallDestinationPath}" />
              <Button Content="{DynamicResource Loc_3227AA966625}" Classes="Primary"
                      IsVisible="{Binding CanChooseDestination}" Click="OnBrowseDestinationClicked" CornerRadius="{DynamicResource RadiusButtonSmall}"
                      Padding="16,4" Height="30" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" CornerRadius="{DynamicResource RadiusSmall}" />

          <Border IsVisible="{Binding HasMessage}" Padding="{DynamicResource SpaceInset3}"
                  CornerRadius="{DynamicResource RoundedMD}"
                  Background="{DynamicResource SurfaceRaisedSubtleBrush}"
                  BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="{DynamicResource BorderThicknessDefault}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource TypeSizeCaption}" />
          </Border>
        </StackPanel>

        <!-- Fallback if launched without an AppImage file -->
        <StackPanel IsVisible="{Binding !HasSelection}" Spacing="{DynamicResource Space3}" HorizontalAlignment="Center">
          <controls:DaisyIcon Icon="package" Size="{DynamicResource IconSizeHero}" HorizontalAlignment="Center"
                              Foreground="{DynamicResource ContentSecondaryBrush}" />
          <TextBlock Text="{DynamicResource Loc_6A2580047C5B}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource Loc_13112C170595}" Classes="Muted" TextAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="380" />
          <Button Content="{DynamicResource Loc_5C6623857CC7}" Classes="Primary Pill" Click="OnChooseFileClicked"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Footer: Quit on left, Install / Open / Reinstall on right -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="36,0,36,28" VerticalAlignment="Bottom">
        <Button Content="{DynamicResource Loc_B3EB37ACB66B}" Classes="Secondary Pill" Click="OnQuitClicked" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource Loc_C630A782A9EB}" Classes="Secondary Pill" Click="OnInstallClicked"
                  IsVisible="{Binding ShowReinstallButton}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="{DynamicResource Loc_ED077F3D8125}" Classes="Primary Pill" Click="OnLaunchSelectedClicked"
                  IsVisible="{Binding ShowOpenButton}" IsDefault="{Binding ShowOpenButton}" MinWidth="100" />
          <Button Content="{DynamicResource Loc_569CA49F4AAF}" Classes="Primary Pill" Click="OnInstallClicked"
                  IsVisible="{Binding ShowFirstTimeInstallButton}" IsDefault="{Binding ShowFirstTimeInstallButton}"
                  IsEnabled="{Binding CanInstall}" MinWidth="100" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
