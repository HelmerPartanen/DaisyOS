<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DaisyOS.Shell.Apps.Mail.MailStyles">
    <Style Selector="TextBlock.MailSecondary">
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeBodySmall}" />
    </Style>
    <Style Selector="TextBlock.MailCaption">
      <Setter Property="Foreground" Value="{DynamicResource ContentTertiaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeCaption}" />
    </Style>
    <Style Selector="ListBox.MailList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="{DynamicResource SpaceInset3}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:selected:pointerover, ListBox.MailList ListBoxItem:pressed">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.MailList ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>
    <Style Selector="ListBox.MailList ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    </Style>
</Styles>
