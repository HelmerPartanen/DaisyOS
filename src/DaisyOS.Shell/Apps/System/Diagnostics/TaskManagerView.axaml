<UserControl x:Class="DaisyOS.Shell.Apps.System.Diagnostics.TaskManagerView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DaisyOS.Shell.Controls;assembly=DaisyOS.Shell" xmlns:diag="clr-namespace:DaisyOS.Shell.Apps.System.Diagnostics"
 x:DataType="diag:TaskManagerViewModel">
 <UserControl.Styles>
  <StyleInclude Source="avares://DaisyOS.Shell/Styles/SidebarNavigationStyles.axaml" />
  <Style Selector="Border.MonitorCard"><Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}"/><Setter Property="Padding" Value="{DynamicResource SpaceInset5}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="TextBlock.Label"><Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}"/><Setter Property="FontSize" Value="{DynamicResource TypeSizeCaption}"/></Style>
  <Style Selector="TextBlock.Value"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="{DynamicResource SpaceInset3}"/><Setter Property="Margin" Value="{DynamicResource Space1}"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource StateHoverBrush}"/></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource StateSelectedBrush}"/></Style>
  <Style Selector="ListBoxItem:selected:pointerover, ListBoxItem:pressed"><Setter Property="Background" Value="{DynamicResource StatePressedBrush}"/></Style>
 </UserControl.Styles>
 <Grid ColumnDefinitions="210,*" Background="{DynamicResource SurfaceBaseSolidBrush}">
  <Border Background="{DynamicResource SurfaceRaisedSubtleBrush}" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,1,0" Padding="16">
   <Grid RowDefinitions="*,Auto" RowSpacing="{DynamicResource Space6}">
    <StackPanel Spacing="{DynamicResource SidebarItemGap}">
     <Button Classes="Large SettingsNavItem" Classes.Active="{Binding IsOverview}" Tag="0" Click="OnNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><controls:DaisyIcon Icon="gauge" Size="{DynamicResource IconSizeMedium}"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Classes="Large SettingsNavItem" Classes.Active="{Binding IsApplications}" Tag="1" Click="OnNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><controls:DaisyIcon Icon="squares-four" Size="{DynamicResource IconSizeMedium}"/><TextBlock Text="Applications" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Classes="Large SettingsNavItem" Classes.Active="{Binding IsProcesses}" Tag="2" Click="OnNavigate"><StackPanel Orientation="Horizontal" Spacing="12"><controls:DaisyIcon Icon="cpu" Size="{DynamicResource IconSizeMedium}"/><TextBlock Text="Processes" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="{DynamicResource Space2}" Margin="{DynamicResource Space2}"><TextBlock Text="SYSTEM UPTIME" Classes="Label"/><TextBlock Text="{Binding Uptime}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessCount, StringFormat='{}{0} processes running'}" Classes="Label"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" x:Name="MainPaneLayout" RowDefinitions="Auto,*">
   <controls:AppWindowTitleBar x:Name="AppTitleBar"/>
   <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,12,24,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
     <StackPanel Spacing="4"><TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TypeSizeHeading}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="Label" TextWrapping="Wrap"/></StackPanel>
     <Button Grid.Column="1" Content="{Binding PauseLabel}" Click="OnPause" VerticalAlignment="Top"/>
     <Button Grid.Column="2" Classes="IconButton Subtle" Click="OnRefresh" ToolTip.Tip="Refresh now" AutomationProperties.Name="Refresh now" VerticalAlignment="Top"><controls:DaisyIcon Icon="arrows-clockwise" Size="{DynamicResource IconSizeMedium}"/></Button>
    </Grid>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource StatusDangerBrush}" TextWrapping="Wrap"/></Border>
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsOverview}" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
       <Border Grid.Column="0" Classes="MonitorCard"><StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Processor" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="100%" Classes="Label"/></Grid>
        <TextBlock Text="{Binding CpuUsage}" Classes="Value"/><TextBlock Text="{Binding CpuDetail}" Classes="Label" TextWrapping="Wrap" MinHeight="32"/>
        <diag:UsageHistory Samples="{Binding CpuHistory}" Stroke="{DynamicResource ActionPrimaryBrush}" Height="96" AutomationProperties.Name="Processor usage history"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Last 2 minutes" Classes="Label"/><TextBlock Grid.Column="1" Text="Now" Classes="Label"/></Grid>
        <ProgressBar MinWidth="0" Value="{Binding CpuPercent}" Maximum="100" Height="5" Foreground="{DynamicResource ActionPrimaryBrush}" AutomationProperties.Name="Processor usage"/>
       </StackPanel></Border>
       <Border Grid.Column="1" Classes="MonitorCard"><StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Memory" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="100%" Classes="Label"/></Grid>
        <TextBlock Text="{Binding MemoryUsage}" Classes="Value"/><TextBlock Text="{Binding MemoryDetail}" Classes="Label" TextWrapping="Wrap" MinHeight="32"/>
        <diag:UsageHistory Samples="{Binding MemoryHistory}" Stroke="{DynamicResource AccentOptionPurpleBrush}" Height="96" AutomationProperties.Name="Memory usage history"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Last 2 minutes" Classes="Label"/><TextBlock Grid.Column="1" Text="Now" Classes="Label"/></Grid>
        <ProgressBar MinWidth="0" Value="{Binding MemoryPercent}" Maximum="100" Height="5" Foreground="{DynamicResource AccentOptionPurpleBrush}" AutomationProperties.Name="Memory usage"/>
       </StackPanel></Border>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
       <Border Grid.Column="0" Classes="MonitorCard"><StackPanel Spacing="12"><TextBlock Text="Disk activity" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*"><StackPanel Spacing="4"><TextBlock Text="Read" Classes="Label"/><TextBlock Text="{Binding DiskRead}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Write" Classes="Label"/><TextBlock Text="{Binding DiskWrite}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold"/></StackPanel></Grid><TextBlock Text="Physical disks · Combined throughput" Classes="Label" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Grid.Column="1" Classes="MonitorCard"><StackPanel Spacing="12"><TextBlock Text="Network activity" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*"><StackPanel Spacing="4"><TextBlock Text="Receive" Classes="Label"/><TextBlock Text="{Binding NetworkReceive}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Send" Classes="Label"/><TextBlock Text="{Binding NetworkSend}" FontSize="{DynamicResource TypeSizeSubtitle}" FontWeight="SemiBold"/></StackPanel></Grid><TextBlock Text="All interfaces · Excludes loopback" Classes="Label" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>
      <Border Classes="MonitorCard"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Swap memory" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SwapDetail}" Classes="Label"/></Grid><ProgressBar MinWidth="0" Value="{Binding SwapPercent}" Height="5"/><TextBlock Text="Disk space used as extra memory when applications need more RAM." Classes="Label" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" IsVisible="{Binding IsList}" RowDefinitions="Auto,*,Auto" RowSpacing="12">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><controls:SearchBar Text="{Binding SearchFilter, Mode=TwoWay}" PlaceholderText="Search by name, PID or executable"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" MinWidth="150" AutomationProperties.Name="Sort by"/></Grid>
     <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource RoundedLG}" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
       <Border Padding="16,12" Background="{DynamicResource SurfaceSunkenBrush}"><Grid ColumnDefinitions="*,110,120" ColumnSpacing="16"><TextBlock Text="{Binding ListSummary}" Classes="Label"/><TextBlock Grid.Column="1" Text="CPU · Total %" Classes="Label"/><TextBlock Grid.Column="2" Text="Memory · RAM" Classes="Label"/></Grid></Border>
       <ListBox Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Running items">
        <ListBox.ItemTemplate><DataTemplate x:DataType="diag:ProcessRowViewModel">
         <Grid ColumnDefinitions="*,110,120" ColumnSpacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space3}"><Border Width="32" Height="32" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource ActionSecondaryBrush}" VerticalAlignment="Center"><Grid><controls:DaisyIcon Icon="{Binding FallbackIcon}" IsVisible="{Binding !HasApplicationIcon}" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ApplicationIcon}" IsVisible="{Binding HasApplicationIcon}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/></Grid></Border><StackPanel Grid.Column="1" Spacing="{DynamicResource Space1}"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding Detail}" Classes="Label" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}"/></StackPanel></Grid>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding CpuText}"/><ProgressBar MinWidth="0" Value="{Binding CpuPercent}" Maximum="100" Height="4" Foreground="{DynamicResource ActionPrimaryBrush}"/></StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding MemoryText}"/><ProgressBar MinWidth="0" Value="{Binding MemoryPercent}" Maximum="100" Height="4" Foreground="{DynamicResource AccentOptionPurpleBrush}"/></StackPanel>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Classes="Label" Margin="24" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="{Binding SelectionDetail}" Classes="Label" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectionDetail}"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Force quit…" IsVisible="{Binding IsProcesses}" IsEnabled="{Binding CanForce}" Click="OnForceQuit"/><Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanEnd}" Click="OnEndSelectedProcessClicked"/></StackPanel></StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Classes="Label" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
