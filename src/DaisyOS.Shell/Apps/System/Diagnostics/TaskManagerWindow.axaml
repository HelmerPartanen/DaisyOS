<Window
    x:Class="DaisyOS.Shell.Apps.System.Diagnostics.TaskManagerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diag="clr-namespace:DaisyOS.Shell.Apps.System.Diagnostics"
    Title="System Monitor"
    Width="1100"
    Height="760"
    MinWidth="920"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    Classes="SidebarAppWindow"
    TextOptions.TextRenderingMode="Antialias"
    Background="{DynamicResource SurfaceBaseSolidBrush}">
  <diag:TaskManagerView x:Name="MonitorContent" DataContext="{Binding}" />
</Window>
