<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls;assembly=DaisyOS.Shell"
             xmlns:rich="clr-namespace:DaisyOS.Shell.Apps.Notes.Editor.Rich"
             xmlns:converters="clr-namespace:DaisyOS.Shell.Converters;assembly=DaisyOS.Shell"
             x:Class="DaisyOS.Shell.Apps.Notes.Editor.Rich.RichEditorView">

  <UserControl.Resources>
    <converters:HalfHeightCornerRadiusConverter x:Key="PickerRadius" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ComboBox.ToolbarPicker, ComboBox.FormattingPicker">
      <Setter Property="CornerRadius" Value="{Binding Bounds.Height, RelativeSource={RelativeSource Self}, Converter={StaticResource PickerRadius}}" />
    </Style>
    <Style Selector="Button.FormattingMenuAction">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.FormattingHeading">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="Margin" Value="12,8,12,4" />
    </Style>
    <Style Selector="StackPanel.DocumentEntering">
      <Style.Animations>
        <Animation Duration="{DynamicResource MotionDurationFast}" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer x:Name="DocumentScroll" Background="Transparent"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="BlocksContainer"
                  Margin="24,64,24,24" Spacing="0" HorizontalAlignment="Stretch" />
    </ScrollViewer>
    <Border Classes="AppToolbar" x:Name="FloatingToolbar" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="12,12,12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="ToolbarScrollLeft" Grid.Column="0" Classes="IconButton Small" IsVisible="False"
                ToolTip.Tip="{DynamicResource Loc_B8DBA9F25B0A}" Click="OnToolbarScrollLeft" AutomationProperties.Name="{DynamicResource Loc_B8DBA9F25B0A}">
          <controls:DaisyIcon Icon="caret-left" Size="{DynamicResource IconSizeStandard}" />
        </Button>
      <ScrollViewer Grid.Column="1" x:Name="FormattingScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FormattingContent" Orientation="Horizontal" Spacing="4">
          <!-- Block Type Selector DropDown -->
          <ComboBox x:Name="BlockTypeCombo"
                    Classes="Flexible ToolbarPicker"
                    MinWidth="120"
                    AutomationProperties.Name="{DynamicResource Loc_9AA08BE49BDD}"
                    Height="{DynamicResource ControlHeightCompact}"
                    MinHeight="{DynamicResource ControlHeightCompact}"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource TypeSizeCaption}"
                    SelectionChanged="OnBlockTypeSelectionChanged">
            <ComboBoxItem Content="{DynamicResource Loc_C3B03DD28595}" Tag="Paragraph" />
            <ComboBoxItem Content="{DynamicResource Loc_D95E9370EF74}" Tag="Heading1" />
            <ComboBoxItem Content="{DynamicResource Loc_3291955E9005}" Tag="Heading2" />
            <ComboBoxItem Content="{DynamicResource Loc_C6845F11C2D3}" Tag="Heading3" />
            <ComboBoxItem Content="{DynamicResource Loc_546D0F9DD97A}" Tag="BulletedList" />
            <ComboBoxItem Content="{DynamicResource Loc_2916C317BF4A}" Tag="NumberedList" />
            <ComboBoxItem Content="{DynamicResource Loc_7346030400BF}" Tag="CheckList" />
            <ComboBoxItem Content="{DynamicResource Loc_EB4CDEBD82BF}" Tag="Quote" />
            <ComboBoxItem Content="{DynamicResource Loc_BFDBD4C5FD05}" Tag="Code" />
          </ComboBox>

          <!-- Formatting Toggles -->
          <Button x:Name="BoldBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_84787DE4AE3F}" Click="OnBoldClicked" AutomationProperties.Name="{DynamicResource Loc_84787DE4AE3F}">
            <controls:DaisyIcon Icon="text-bold" Size="{DynamicResource IconSizeStandard}" />
          </Button>
          <Button x:Name="ItalicBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_CCC60DFF1674}" Click="OnItalicClicked" AutomationProperties.Name="{DynamicResource Loc_CCC60DFF1674}">
            <controls:DaisyIcon Icon="text-italic" Size="{DynamicResource IconSizeStandard}" />
          </Button>
          <Button x:Name="UnderlineBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_BBDF501C30F8}" Click="OnUnderlineClicked" AutomationProperties.Name="{DynamicResource Loc_BBDF501C30F8}">
            <controls:DaisyIcon Icon="text-underline" Size="{DynamicResource IconSizeStandard}" />
          </Button>


          <!-- Insert Image (App.PickImageFilesAsync) -->
          <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_B9B6EDDA8ADD}" Click="OnInsertImageClicked" AutomationProperties.Name="{DynamicResource Loc_B9B6EDDA8ADD}">
            <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeStandard}" />
          </Button>

          <Button x:Name="MoreFormattingButton" Classes="IconButton Small">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="FormattingMenu">
                <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="AdvancedFormattingContent" Width="264" Spacing="4">
                    <!-- Font Family Selector -->
                    <TextBlock x:Name="FontFamilyHeading" Classes="FormattingHeading" />
                    <ComboBox x:Name="FontFamilyCombo"
                              Classes="Flexible FormattingPicker"
                              Height="{DynamicResource ControlHeightCompact}"
                              MinHeight="{DynamicResource ControlHeightCompact}"
                              VerticalAlignment="Center"
                              MinWidth="104"
                              FontSize="{DynamicResource TypeSizeCaption}"
                              SelectionChanged="OnFontFamilySelectionChanged">
                      <ComboBoxItem Content="{DynamicResource Loc_A6E7CD03E301}" Tag="SystemFont" />
                      <ComboBoxItem Content="{DynamicResource Loc_30A4A5BCA8F4}" />
                      <ComboBoxItem Content="{DynamicResource Loc_26C12A414C33}" />
                      <ComboBoxItem Content="{DynamicResource Loc_96C4069D9BB6}" />
                      <ComboBoxItem Content="{DynamicResource Loc_22C971284F12}" />
                      <ComboBoxItem Content="{DynamicResource Loc_1B5E747E5031}" />
                    </ComboBox>

                    <!-- Font Size Stepper -->
                    <TextBlock x:Name="FontSizeHeading" Classes="FormattingHeading" />
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                      <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_303A5795D937}" Click="OnDecreaseFontSizeClicked" AutomationProperties.Name="{DynamicResource Loc_303A5795D937}">
                        <controls:DaisyIcon Icon="minus" Size="{DynamicResource IconSizeSmall}" />
                      </Button>
                      <TextBlock x:Name="FontSizeLabel" Text="16" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" VerticalAlignment="Center" Width="20" TextAlignment="Center" />
                      <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_ECDF43CB43E8}" Click="OnIncreaseFontSizeClicked" AutomationProperties.Name="{DynamicResource Loc_ECDF43CB43E8}">
                        <controls:DaisyIcon Icon="plus" Size="{DynamicResource IconSizeSmall}" />
                      </Button>
                    </StackPanel>

                    <!-- Font Weight Selector -->
                    <TextBlock x:Name="FontWeightHeading" Classes="FormattingHeading" />
                    <ComboBox x:Name="FontWeightCombo"
                              Classes="Flexible FormattingPicker"
                              Height="{DynamicResource ControlHeightCompact}"
                              MinHeight="{DynamicResource ControlHeightCompact}"
                              VerticalAlignment="Center"
                              MinWidth="104"
                              FontSize="{DynamicResource TypeSizeCaption}"
                              SelectionChanged="OnFontWeightSelectionChanged">
                      <ComboBoxItem Content="{DynamicResource Loc_B455784AB530}" Tag="400" />
                      <ComboBoxItem Content="{DynamicResource Loc_8E588CD18774}" Tag="500" />
                      <ComboBoxItem Content="{DynamicResource Loc_FFC5DE721473}" Tag="600" />
                      <ComboBoxItem Content="{DynamicResource Loc_94FEE62E68E2}" Tag="700" />
                      <ComboBoxItem Content="{DynamicResource Loc_F0A0B33594B2}" Tag="800" />
                    </ComboBox>
                    <Border Height="1" Background="{DynamicResource StrokeSubtleBrush}" Margin="8,8" />
                    <Button x:Name="StrikeBtn" Classes="Subtle FormattingMenuAction" ToolTip.Tip="{DynamicResource Loc_9AABBCB2C18D}" Click="OnStrikeClicked" AutomationProperties.Name="{DynamicResource Loc_9AABBCB2C18D}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:DaisyIcon Icon="text-strikethrough" Size="{DynamicResource IconSizeStandard}" /><TextBlock Text="{DynamicResource Loc_9AABBCB2C18D}" /></StackPanel>
                    </Button>
                    <!-- Color & Highlight Pickers -->
                    <Button Classes="Subtle FormattingMenuAction" ToolTip.Tip="{DynamicResource Loc_2EA2323426F3}" AutomationProperties.Name="{DynamicResource Loc_2EA2323426F3}">
                      <Button.Flyout>
                        <Flyout>
                          <WrapPanel Width="180">
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource ContentPrimaryBrush}" Click="OnColorSelected" Tag="" ToolTip.Tip="{DynamicResource Loc_E78B0327D832}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource ActionPrimaryBrush}" Click="OnColorSelected" Tag="accent" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorGreenBrush}" Click="OnColorSelected" Tag="{StaticResource EditorGreenValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorYellowBrush}" Click="OnColorSelected" Tag="{StaticResource EditorYellowValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorRedBrush}" Click="OnColorSelected" Tag="{StaticResource EditorRedValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorPurpleBrush}" Click="OnColorSelected" Tag="{StaticResource EditorPurpleValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorSlateBrush}" Click="OnColorSelected" Tag="{StaticResource EditorSlateValue}" CornerRadius="4" />
                          </WrapPanel>
                        </Flyout>
                      </Button.Flyout><StackPanel Orientation="Horizontal" Spacing="8"><controls:DaisyIcon Icon="palette" Size="{DynamicResource IconSizeSmall}" /><TextBlock Text="{DynamicResource Loc_2EA2323426F3}" /></StackPanel></Button>

                    <Button Classes="Subtle FormattingMenuAction" ToolTip.Tip="{DynamicResource Loc_48AAE41545CE}" AutomationProperties.Name="{DynamicResource Loc_48AAE41545CE}">
                      <Button.Flyout>
                        <Flyout>
                          <WrapPanel Width="180">
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource TransparentBrush}" Click="OnHighlightSelected" Tag="" CornerRadius="4" ToolTip.Tip="{DynamicResource Loc_DC937B598926}">
                              <TextBlock Text="✕" FontSize="{DynamicResource TypeSizeCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ContentSecondaryBrush}" />
                            </Button>
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorHighlightYellowBrush}" Click="OnHighlightSelected" Tag="{StaticResource EditorHighlightYellowValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorHighlightBlueBrush}" Click="OnHighlightSelected" Tag="{StaticResource EditorHighlightBlueValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorHighlightGreenBrush}" Click="OnHighlightSelected" Tag="{StaticResource EditorHighlightGreenValue}" CornerRadius="4" />
                            <Button Focusable="True" Width="32" Height="{DynamicResource ControlHeightCompact}" Margin="2" Background="{DynamicResource EditorHighlightRedBrush}" Click="OnHighlightSelected" Tag="{StaticResource EditorHighlightRedValue}" CornerRadius="4" />
                          </WrapPanel>
                        </Flyout>
                      </Button.Flyout><StackPanel Orientation="Horizontal" Spacing="8"><controls:DaisyIcon Icon="highlighter" Size="{DynamicResource IconSizeStandard}" /><TextBlock Text="{DynamicResource Loc_48AAE41545CE}" /></StackPanel></Button>

                    <!-- Insert Divider -->
                    <Button Classes="Subtle FormattingMenuAction" ToolTip.Tip="{DynamicResource Loc_8BBA8E6B7138}" Click="OnInsertDividerClicked" AutomationProperties.Name="{DynamicResource Loc_8BBA8E6B7138}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:DaisyIcon Icon="rows" Size="{DynamicResource IconSizeStandard}" /><TextBlock Text="{DynamicResource Loc_8BBA8E6B7138}" /></StackPanel>
                    </Button>

                    <!-- Clear Formatting -->
                    <Button Classes="Subtle FormattingMenuAction" ToolTip.Tip="{DynamicResource Loc_804CF3352C42}" Click="OnClearFormattingClicked" AutomationProperties.Name="{DynamicResource Loc_804CF3352C42}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:DaisyIcon Icon="text-clear" Size="{DynamicResource IconSizeStandard}" /><TextBlock Text="{DynamicResource Loc_804CF3352C42}" /></StackPanel>
                    </Button>

                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
            <controls:DaisyIcon Icon="dots-three" Size="{DynamicResource IconSizeStandard}" />
          </Button>


        </StackPanel>
      </ScrollViewer>
        <Button x:Name="ToolbarScrollRight" Grid.Column="2" Classes="IconButton Small" IsVisible="False"
                ToolTip.Tip="{DynamicResource Loc_E58F65E309FD}" Click="OnToolbarScrollRight" AutomationProperties.Name="{DynamicResource Loc_E58F65E309FD}">
          <controls:DaisyIcon Icon="caret-right" Size="{DynamicResource IconSizeStandard}" />
        </Button>
      </Grid>
    </Border>
    <Border x:Name="ImageImportError" IsVisible="False" VerticalAlignment="Bottom"
            Background="{DynamicResource StatusDangerContainerBrush}" Padding="{DynamicResource SpaceInset3}">
      <TextBlock x:Name="ImageImportErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ContentPrimaryBrush}" />
    </Border>
  </Grid>
</UserControl>
