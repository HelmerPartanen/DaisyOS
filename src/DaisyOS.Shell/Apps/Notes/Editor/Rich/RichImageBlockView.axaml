<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             x:Class="DaisyOS.Shell.Apps.Notes.Editor.Rich.RichImageBlockView">


  <StackPanel x:Name="RootContainer" Spacing="8" Margin="0,12" HorizontalAlignment="Stretch">
    <!-- Image with interactive handles and adorners -->
    <Grid Focusable="True" x:Name="ImageContainer" HorizontalAlignment="Center">
      <!-- The Rendered Image in Border with CornerRadius -->
      <Border x:Name="ImageBorder"
              MaxWidth="{Binding #RootContainer.Bounds.Width}"
              CornerRadius="12"
              ClipToBounds="True"
              BorderThickness="1"
              BorderBrush="{DynamicResource StrokeDefaultBrush}"
              Background="{DynamicResource SurfaceRaisedSubtleBrush}">
        <Image x:Name="ImageDisplay"
               Stretch="Uniform" />
      </Border>

      <!-- Selection & Hover Adorner Overlay -->
      <Border x:Name="AdornerOverlay"
              CornerRadius="{Binding #ImageBorder.CornerRadius}"
              BorderThickness="2"
              BorderBrush="{DynamicResource ActionPrimaryBrush}"
              IsVisible="False"
              IsHitTestVisible="True">
        <Panel>
          <!-- Top Floating Action Pill Toolbar -->
          <Border Classes="AppToolbar" HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,8,0,0"
                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                  BorderThickness="1"
                  MaxWidth="{Binding #ImageBorder.Bounds.Width}"
                  BoxShadow="{DynamicResource ElevationFlyoutShadow}">
            <WrapPanel ItemSpacing="4" LineSpacing="4">
              <!-- Alignment controls -->
              <Button x:Name="AlignLeftBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_94A69331C723}" Click="OnAlignLeftClicked" AutomationProperties.Name="{DynamicResource Loc_94A69331C723}">
                <controls:DaisyIcon Icon="text-align-left" Size="{DynamicResource IconSizeSmall}" />
              </Button>
              <Button x:Name="AlignCenterBtn" Classes="IconButton Small Active" ToolTip.Tip="{DynamicResource Loc_12C2425371B2}" Click="OnAlignCenterClicked" AutomationProperties.Name="{DynamicResource Loc_12C2425371B2}">
                <controls:DaisyIcon Icon="text-align-center" Size="{DynamicResource IconSizeSmall}" />
              </Button>
              <Button x:Name="AlignRightBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_9B0274C13C1C}" Click="OnAlignRightClicked" AutomationProperties.Name="{DynamicResource Loc_9B0274C13C1C}">
                <controls:DaisyIcon Icon="text-align-right" Size="{DynamicResource IconSizeSmall}" />
              </Button>
              <Button x:Name="AlignFullBtn" Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_827E684A942F}" Click="OnAlignFullClicked" AutomationProperties.Name="{DynamicResource Loc_827E684A942F}">
                <controls:DaisyIcon Icon="arrow-expand-01" Size="{DynamicResource IconSizeSmall}" />
              </Button>

              <Rectangle Width="1" Height="16" Fill="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />

              <!-- Radius Presets -->
              <Button Classes="Subtle ToolbarAction" ToolTip.Tip="{DynamicResource Loc_8328A86E6441}" Click="OnRadius0Clicked">
                <TextBlock Text="0" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" />
              </Button>
              <Button Classes="Subtle ToolbarAction" ToolTip.Tip="{DynamicResource Loc_B0C3D382397D}" Click="OnRadius8Clicked">
                <TextBlock Text="8" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" />
              </Button>
              <Button Classes="Subtle ToolbarAction" ToolTip.Tip="{DynamicResource Loc_E04AB8BEFE55}" Click="OnRadius16Clicked">
                <TextBlock Text="16" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" />
              </Button>

              <Rectangle Width="1" Height="16" Fill="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />

              <!-- Move Up / Move Down -->
              <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_ABA357D73D3C}" Click="OnMoveUpClicked" AutomationProperties.Name="{DynamicResource Loc_ABA357D73D3C}">
                <controls:DaisyIcon Icon="arrow-up" Size="{DynamicResource IconSizeSmall}" />
              </Button>
              <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_F2DABA87A9A7}" Click="OnMoveDownClicked" AutomationProperties.Name="{DynamicResource Loc_F2DABA87A9A7}">
                <controls:DaisyIcon Icon="arrow-down" Size="{DynamicResource IconSizeSmall}" />
              </Button>

              <!-- Delete -->
              <Button Classes="IconButton Small" ToolTip.Tip="{DynamicResource Loc_3691FF40984E}" Click="OnDeleteClicked" AutomationProperties.Name="{DynamicResource Loc_3691FF40984E}">
                <controls:DaisyIcon Icon="trash" Size="{DynamicResource IconSizeSmall}" Foreground="{DynamicResource StatusDangerBrush}" />
              </Button>
            </WrapPanel>
          </Border>

          <!-- Corner Radius Dot Handle (Top-Left) -->
          <Border x:Name="RadiusHandle"
                  Width="18" Height="18"
                  CornerRadius="9"
                  Background="{DynamicResource SurfaceBaseSolidBrush}"
                  BorderBrush="{DynamicResource ActionPrimaryBrush}"
                  BorderThickness="2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12,12,0,0"
                  Cursor="Hand"
                  ToolTip.Tip="{DynamicResource Loc_3E08E9B6674C}">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource ActionPrimaryBrush}" />
          </Border>

          <!-- Bottom-Right Resize Handle -->
          <Border x:Name="ResizeHandleRight"
                  Width="18" Height="18"
                  CornerRadius="9"
                  Background="{DynamicResource ActionPrimaryBrush}"
                  BorderBrush="{DynamicResource SurfaceBaseSolidBrush}"
                  BorderThickness="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-6,-6"
                  Cursor="BottomRightCorner"
                  ToolTip.Tip="{DynamicResource Loc_B379570D4FBB}" />

          <!-- Live Dimension & Radius Readout Badge -->
          <Border x:Name="FeedbackBadge"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,12"
                  Background="{DynamicResource SurfaceBaseSolidBrush}"
                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSurface}"
                  Padding="8,3"
                  IsVisible="False">
            <TextBlock x:Name="FeedbackBadgeText"
                       Text="{DynamicResource Loc_03B7319370FE}"
                       FontSize="{DynamicResource TypeSizeCaption}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ContentPrimaryBrush}" />
          </Border>
        </Panel>
      </Border>
    </Grid>

    <!-- Optional Caption Input Field -->
    <TextBox x:Name="CaptionInput"
             Classes="EditorTextBox"
             PlaceholderText="{DynamicResource Loc_858CB9F450AF}"
             FontSize="{DynamicResource TypeSizeCaption}"
             Foreground="{DynamicResource ContentSecondaryBrush}"
             TextAlignment="Center"
             HorizontalAlignment="Center"
             BorderThickness="0"
             Background="Transparent"
             Margin="0,2,0,0" />
  </StackPanel>
</UserControl>
