<Window
    x:Class="DaisyOS.Shell.Apps.Calendar.CalendarWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="clr-namespace:DaisyOS.Shell.Apps.Calendar"
    Title="{DynamicResource Loc_D5D0A30B517E}"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="560"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="Full"
    TextOptions.TextRenderingMode="Antialias"
    Background="{DynamicResource SurfaceBaseBrush}"
    PointerPressed="OnWindowPointerPressed">
  <calendar:CalendarView DataContext="{Binding}" />
</Window>
