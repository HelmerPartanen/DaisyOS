<UserControl
    x:Class="DaisyOS.Shell.Apps.Calendar.CalendarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="clr-namespace:DaisyOS.Shell.Apps.Calendar"
    xmlns:systemBar="clr-namespace:DaisyOS.Shell.Views.Components.SystemBar"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    x:DataType="calendar:CalendarViewModel"
    Background="Transparent">

  <UserControl.Styles>
    <Style Selector="Button.CalendarNavButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.CalendarNavButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.CalendarNavButton:pressed">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <Style Selector="Border.CalendarCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedLG}" />
    </Style>

    <Style Selector="Border.WeekDay">
      <Setter Property="Height" Value="54" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.DayNumberBadge">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurfaceInner}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.DayNumberBadge.IsToday">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}" />
    </Style>
    <Style Selector="Border.DayNumberBadge.IsToday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
    </Style>
    <Style Selector="Border.EventBlock">
      <Setter Property="Background" Value="{DynamicResource ActionSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.TimelineColumn, Border.TimelineHour">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Button.CalendarPrimaryAction">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="228,1,*,1,208" Background="{DynamicResource SurfaceBaseBrush}">

    <!-- Month navigator and intentionally sparse calendar source list. -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBaseBrush}">
      <ScrollViewer>
        <StackPanel Spacing="20" Margin="16,18">
          <systemBar:CustomCalendarView Margin="-4,0" />

          <Border Height="1" Background="{DynamicResource StrokeDefaultBrush}" />

          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource Loc_87DA6A26F40B}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource ContentDisabledBrush}" />
            <Border Classes="CalendarCard" Padding="12">
              <StackPanel Spacing="8">
                <Border Width="32" Height="32" CornerRadius="{DynamicResource RadiusSurfaceInner}" Background="{DynamicResource ActionSecondaryBrush}" HorizontalAlignment="Left">
                  <controls:DaisyIcon Icon="calendar-check" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentOnSecondaryActionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource Loc_0DCFBD5190CF}" FontSize="{DynamicResource TypeSizeBodySmall}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc_770E6F5690DA}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Divider -->
    <Border Grid.Column="1" Background="{DynamicResource StrokeDefaultBrush}" />

    <!-- Week agenda. The grid remains useful with no events and never fabricates a schedule. -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding CurrentMonthYear}" FontSize="{DynamicResource TypeSizeHeading}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WeekRange}" FontSize="{DynamicResource TypeSizeBodySmall}" Foreground="{DynamicResource ContentSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="Active CalendarPrimaryAction" Height="34" Padding="12,0" Command="{Binding OpenEventComposerCommand}" ToolTip.Tip="{DynamicResource Loc_5651FAEE9626}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:DaisyIcon Icon="plus" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentOnActionBrush}" />
              <TextBlock Text="{DynamicResource Loc_7CDC2E276045}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Border Background="{DynamicResource ActionSecondaryBrush}" CornerRadius="{DynamicResource RoundedPill}" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:DaisyIcon Icon="calendar-blank" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentOnSecondaryActionBrush}" />
              <TextBlock Text="{DynamicResource Loc_E78041AB51A8}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource ContentOnSecondaryActionBrush}" />
            </StackPanel>
          </Border>
          <Button Classes="ShellButton" Height="{DynamicResource ControlHeightStandard}" Padding="10,0" Command="{Binding GoToTodayCommand}" ToolTip.Tip="{DynamicResource Loc_7BD2C90ACEBE}">
            <TextBlock Text="{DynamicResource Loc_2B065C7C9CE4}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource ContentSecondaryBrush}" />
          </Button>
          <Border Width="1" Height="20" Background="{DynamicResource StrokeDefaultBrush}" Margin="2,0" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="ShellButton" Width="32" Height="{DynamicResource ControlHeightStandard}" Padding="0" CornerRadius="{DynamicResource RadiusSurfaceInner}" Command="{Binding PreviousWeekCommand}" ToolTip.Tip="{DynamicResource Loc_C0F8BBCD4176}">
              <controls:DaisyIcon Icon="caret-left" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="ShellButton" Width="32" Height="{DynamicResource ControlHeightStandard}" Padding="0" CornerRadius="{DynamicResource RadiusSurfaceInner}" Command="{Binding NextWeekCommand}" ToolTip.Tip="{DynamicResource Loc_21FBDE19CFB0}">
              <controls:DaisyIcon Icon="caret-right" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="58,*" Margin="16,0,16,12">
        <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekDays}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="calendar:CalendarDayViewModel">
              <Border Classes="WeekDay" Margin="2,0">
                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DayName}" HorizontalAlignment="Center" FontWeight="Medium" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentDisabledBrush}" />
                  <Border Classes="DayNumberBadge" Classes.IsToday="{Binding IsToday}">
                    <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource TypeSizeBodyLarge}" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <ScrollViewer Grid.Row="2" Padding="16,0,16,16">
        <Grid ColumnDefinitions="58,*" Height="600">
          <Grid Grid.Column="0" RowDefinitions="60,60,60,60,60,60,60,60,60,60" IsHitTestVisible="False">
            <TextBlock Grid.Row="0" Text="{Binding Time8}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="1" Text="{Binding Time9}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="2" Text="{Binding Time10}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="3" Text="{Binding Time11}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="4" Text="{Binding Time12}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="5" Text="{Binding Time13}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="6" Text="{Binding Time14}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="7" Text="{Binding Time15}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="8" Text="{Binding Time16}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Grid.Row="9" Text="{Binding Time17}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" Margin="0,-7,8,0" />
            <TextBlock Text="{Binding Time18}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,-7" />
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="60,60,60,60,60,60,60,60,60,60" ColumnDefinitions="*,*,*,*,*,*,*" ClipToBounds="True">
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="0" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="1" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="2" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="3" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="4" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="5" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,0,1" />
            <Border Classes="TimelineColumn" Grid.RowSpan="10" Grid.Column="6" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,1,1" />

            <Border Classes="TimelineHour" Grid.Row="1" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="2" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="3" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="4" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="5" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="6" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="7" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="8" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />
            <Border Classes="TimelineHour" Grid.Row="9" Grid.ColumnSpan="7" Height="1" Background="{DynamicResource StrokeDefaultBrush}" VerticalAlignment="Top" />

            <Canvas IsVisible="{Binding IsCurrentWeek}" IsHitTestVisible="False">
              <Border Height="2"
                      Width="{Binding $parent[Canvas].Bounds.Width}"
                      Background="{DynamicResource StatusDangerBrush}"
                      Canvas.Top="{Binding CurrentTimeTopOffset}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusDangerBrush}" Margin="-4,-3,0,0" HorizontalAlignment="Left" />
              </Border>
            </Canvas>

            <ItemsControl Grid.RowSpan="10" Grid.ColumnSpan="7" ItemsSource="{Binding Events}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="Grid.Column" Value="{Binding Column}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Grid ColumnDefinitions="*,*,*,*,*,*,*" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="calendar:CalendarEventViewModel">
                  <Border Classes="EventBlock" Margin="{Binding Margin}" Height="{Binding Height}" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding TimeRange}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Divider -->
    <Border Grid.Column="3" Background="{DynamicResource StrokeDefaultBrush}" />

    <!-- The composer opens from the primary action and saves real local events. -->
    <Border Grid.Column="4" Background="{DynamicResource SurfaceBaseBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding IsEventComposerClosed}" Spacing="16" Margin="18,22">
          <TextBlock Text="{DynamicResource Loc_0AD702649781}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource ContentDisabledBrush}" />
          <TextBlock Text="{DynamicResource Loc_BDB2F5C35273}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource Loc_4CA3168E38B7}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Loc_71225448C001}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsEventComposerOpen}" Spacing="14" Margin="18,22">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Loc_4D056E44EBA3}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource ContentDisabledBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ShellButton" Width="28" Height="28" Command="{Binding CancelEventComposerCommand}" ToolTip.Tip="{DynamicResource Loc_19766ED6CCB2}">
              <controls:DaisyIcon Icon="x" Size="{DynamicResource IconSizeStandard}" />
            </Button>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Loc_7E8CD2056DA7}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" />
            <TextBox Text="{Binding NewEventTitle}" PlaceholderText="{DynamicResource Loc_47CDB7664393}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Loc_99C40AB40592}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" />
            <CalendarDatePicker SelectedDate="{Binding NewEventDate}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{DynamicResource Loc_96DBEDECA7DF}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" />
              <TextBox Text="{Binding NewEventStartTime}" PlaceholderText="{Binding StartTimePlaceholder}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{DynamicResource Loc_E98982C9F2BA}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" />
              <TextBox Text="{Binding NewEventEndTime}" PlaceholderText="{Binding EndTimePlaceholder}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding EventComposerError}" IsVisible="{Binding HasEventComposerError}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource StatusDangerBrush}" TextWrapping="Wrap" />

          <Button Classes="Active" Height="38" Command="{Binding SaveEventCommand}">
            <TextBlock Text="{DynamicResource Loc_2EA84A3CF7AB}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
