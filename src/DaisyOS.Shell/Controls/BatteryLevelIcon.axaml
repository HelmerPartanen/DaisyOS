<UserControl x:Class="DaisyOS.Shell.Controls.BatteryLevelIcon"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Viewbox Stretch="Uniform">
    <Canvas Width="25" Height="14">
      <!-- Keep the charge inside the stroke's antialiasing fringe. The optical
           inset prevents the outline becoming a dark bevel at taskbar scale. -->
      <Border x:Name="FillBar"
              Canvas.Left="2"
              Canvas.Top="2"
              Width="0"
              Height="9.5"
              Clip="M1.75 0H16.75A1.75 1.75 0 0 1 18.5 1.75V7.75A1.75 1.75 0 0 1 16.75 9.5H1.75A1.75 1.75 0 0 1 0 7.75V1.75A1.75 1.75 0 0 1 1.75 0Z"
              Background="{Binding FillBrush, ElementName=Root}" />

      <!-- Matches battery-charging-01.svg so both states share one silhouette. -->
      <Path x:Name="OutlinePath"
            Data="M0.75 9.75V3.75C0.75 2.09315 2.09315 0.75 3.75 0.75H18.75C20.4069 0.75 21.75 2.09315 21.75 3.75V9.75C21.75 11.4069 20.4069 12.75 18.75 12.75H3.75C2.09315 12.75 0.75 11.4069 0.75 9.75Z"
            Fill="Transparent"
            Stroke="{Binding OutlineBrush, ElementName=Root}"
            StrokeThickness="1.5"
            StrokeLineCap="Round"
            StrokeJoin="Round" />

      <Path Data="M23.25 8.75V4.75C23.25 4.75 24.75 4.75 24.75 6.75C24.75 8.75 23.25 8.75 23.25 8.75Z"
            Fill="{Binding OutlineBrush, ElementName=Root}" />
    </Canvas>
  </Viewbox>
</UserControl>
