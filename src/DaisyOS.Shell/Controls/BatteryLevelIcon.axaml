<UserControl x:Class="DaisyOS.Shell.Controls.BatteryLevelIcon"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">
  <UserControl.Styles>
    <Style Selector="controls|BatteryLevelIcon">
      <Setter Property="FillBrush" Value="#FFFFFF" />
      <Setter Property="BaseBrush" Value="{DynamicResource ContentTertiaryBrush}" />
    </Style>
    <Style Selector="controls|BatteryLevelIcon.Low">
      <Setter Property="FillBrush" Value="#FFCC00" />
    </Style>
    <Style Selector="controls|BatteryLevelIcon.Critical">
      <Setter Property="FillBrush" Value="{DynamicResource StatusDangerBrush}" />
    </Style>
    <Style Selector="controls|BatteryLevelIcon.Charging">
      <Setter Property="FillBrush" Value="{DynamicResource BatteryChargingBrush}" />
    </Style>
  </UserControl.Styles>

  <Viewbox Stretch="Uniform">
    <Canvas Width="25" Height="14">
      <!-- Mirror battery.svg with a native path so body opacity is applied by
           Avalonia rather than the SVG custom drawing operation. -->
      <Path x:Name="BatteryBody"
            Canvas.Left="0"
            Canvas.Top="1"
            Width="24"
            Height="12"
            Opacity="0.35"
            Fill="{Binding BaseBrush, ElementName=Root}"
            Data="M0 4V8C0 10.2091 1.79086 12 4 12H17C19.2091 12 21 10.2091 21 8V4C21 1.79086 19.2091 0 17 0H4C1.79086 0 0 1.79086 0 4Z M22.5 8V4C22.5 4 24 4 24 6C24 8 22.5 8 22.5 8Z" />

      <!-- The charge uses the exact body silhouette as its clip, so partial
           levels retain the rounded leading edge without any border artifacts. -->
      <Border x:Name="FillBar"
              Canvas.Left="0"
              Canvas.Top="1"
              Width="0"
              Height="12"
              Clip="M0 4V8C0 10.2091 1.79086 12 4 12H17C19.2091 12 21 10.2091 21 8V4C21 1.79086 19.2091 0 17 0H4C1.79086 0 0 1.79086 0 4Z"
              Background="{Binding FillBrush, ElementName=Root}" />

      <!-- lightning.svg is independent of the charge mask and remains centered
           in the 21px cell at every percentage. -->
      <controls:DaisyIcon x:Name="ChargingGlyph"
                          Icon="lightning"
                          Canvas.Left="7.75"
                          Canvas.Top="2"
                          Width="5.5"
                          Height="10"
                          Foreground="{DynamicResource ContentOnPrimaryActionBrush}"
                          IsVisible="{Binding IsCharging, ElementName=Root}" />
    </Canvas>
  </Viewbox>
</UserControl>
