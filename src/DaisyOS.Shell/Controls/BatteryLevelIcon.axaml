<UserControl x:Class="DaisyOS.Shell.Controls.BatteryLevelIcon"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <!-- The interior is the cavity of Assets/Icons/HugeIcons/battery.svg.
           Keeping its left edge rounded and its right edge square makes the
           charge visibly grow from left to right without filling the terminal. -->
      <Border x:Name="FillBar"
              Canvas.Left="2.75"
              Canvas.Top="6.75"
              Width="0"
              Height="10.5"
              CornerRadius="4,0,0,4"
              Background="{Binding FillBrush, ElementName=Root}" />

      <!-- Exact outline geometry from battery.svg. -->
      <Path Data="M8 18H16.5C16.9644 18 17.1966 18 17.3916 17.9743C18.7378 17.7971 19.7971 16.7378 19.9743 15.3916C20 15.1966 20 14.9644 20 14.5C21.1046 14.5 22 13.6046 22 12.5V11.5C22 10.3954 21.1046 9.5 20 9.5C20 9.03558 20 8.80337 19.9743 8.60842C19.7971 7.26222 18.7378 6.2029 17.3916 6.02567C17.1966 6 16.9644 6 16.5 6H8C5.17157 6 3.75736 6 2.87868 6.87868C2 7.75736 2 9.17157 2 12C2 14.8284 2 16.2426 2.87868 17.1213C3.75736 18 5.17157 18 8 18Z"
            Fill="Transparent"
            Stroke="{Binding OutlineBrush, ElementName=Root}"
            StrokeThickness="1.5"
            StrokeLineCap="Round"
            StrokeJoin="Round" />
    </Canvas>
  </Viewbox>
</UserControl>
