<UserControl x:Class="DaisyOS.Shell.Controls.BatteryLevelIcon"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">
  <Viewbox Stretch="Uniform">
    <Canvas Width="25" Height="14">
      <!-- battery.svg owns the complete base silhouette, including the cap. -->
      <controls:DaisyIcon x:Name="BatteryBody"
                          Icon="battery"
                          Canvas.Left="0"
                          Canvas.Top="1"
                          Width="24"
                          Height="12"
                          Foreground="{Binding BaseBrush, ElementName=Root}" />

      <!-- The charge uses the exact body silhouette as its clip, so partial
           levels retain the rounded leading edge without any border artifacts. -->
      <Border x:Name="FillBar"
              Canvas.Left="0"
              Canvas.Top="1"
              Width="0"
              Height="12"
              Clip="M3 0H18A3 3 0 0 1 21 3V9A3 3 0 0 1 18 12H3A3 3 0 0 1 0 9V3A3 3 0 0 1 3 0Z"
              Background="{Binding FillBrush, ElementName=Root}" />

      <!-- lightning.svg is independent of the charge mask and remains centered
           in the 21px cell at every percentage. -->
      <controls:DaisyIcon x:Name="ChargingGlyph"
                          Icon="lightning"
                          Canvas.Left="7.75"
                          Canvas.Top="2"
                          Width="5.5"
                          Height="10"
                          Foreground="{DynamicResource ContentOnPrimaryActionBrush}"
                          IsVisible="{Binding IsCharging, ElementName=Root}" />
    </Canvas>
  </Viewbox>
</UserControl>
