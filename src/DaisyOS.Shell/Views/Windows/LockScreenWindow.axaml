<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
        xmlns:wallpaper="clr-namespace:DaisyOS.Shell.Views.Components.Wallpaper"
        x:Class="DaisyOS.Shell.Views.Windows.LockScreenWindow"
        Title="{DynamicResource Loc_1D795D7A7686}"
        WindowState="FullScreen"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource LockScreenCanvasBrush}">

  <Window.Styles>
    <Style Selector="Border.spectrumBar">
      <Setter Property="Background" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.LockMediaBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationFast}" Easing="{StaticResource MotionEaseMove}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.LockMediaBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.LockMediaBtn:pressed">
      <Setter Property="RenderTransform" Value="scale(0.90)" />
    </Style>
    <Style Selector="Border.LockMediaArtwork">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationBase}" Easing="{StaticResource MotionEaseMove}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.LockMediaArtwork:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.025)" />
    </Style>
    <Style Selector="Border.LockMediaArtwork:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.LauncherUtility">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCircle}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationFast}" Easing="{StaticResource MotionEaseMove}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.LauncherUtility:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.LauncherUtility:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid"
        Opacity="0">

    <Panel x:Name="LockBackground" Background="{DynamicResource LockScreenCanvasBrush}">
      <!-- Background Wallpaper Layer -->
      <wallpaper:WallpaperLayer x:Name="LockWallpaper"
                                IgnoreDesktopOcclusion="True" />

      <!-- Fullscreen Spotify Canvas Video / Blurred Artwork Layer -->
      <Panel x:Name="LockCanvasLayer"
             Opacity="0"
             IsVisible="False"
             IsHitTestVisible="False">
        <Panel x:Name="LockCanvasFallbackPanel">
          <Border Background="{DynamicResource LockScreenMediaBackdropBrush}" />
          <Image x:Name="LockCanvasFallbackImage"
                 Stretch="UniformToFill"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.72"
                 RenderTransform="scale(1.12)"
                 RenderOptions.BitmapInterpolationMode="HighQuality">
            <Image.Effect>
              <BlurEffect Radius="44" />
            </Image.Effect>
          </Image>
        </Panel>
        <wallpaper:WallpaperLayer x:Name="LockCanvasWallpaper"
                                  IgnoreDesktopOcclusion="True"
                                  IsVisible="False">
        </wallpaper:WallpaperLayer>
        <Border Background="{DynamicResource LockScreenMediaScrimBrush}" IsHitTestVisible="False" />
      </Panel>

      <!-- Subtle Vignette / Scrim Overlay for Legibility -->
      <Border x:Name="LockWallpaperScrim" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0.0" Color="{DynamicResource BlackAlpha25Color}" />
            <GradientStop Offset="0.25" Color="{DynamicResource BlackAlpha08Color}" />
            <GradientStop Offset="0.65" Color="{DynamicResource BlackAlpha08Color}" />
            <GradientStop Offset="1.0" Color="{DynamicResource BlackAlpha33Color}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Border x:Name="LockWallpaperTint" Background="Black" Opacity="0" IsHitTestVisible="False" />
    </Panel>

    <!-- Main Foreground Content Grid -->
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer x:Name="LockContentScroll" Grid.Row="0"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
      <Grid x:Name="MainContentGrid" RowDefinitions="Auto,*,Auto" Margin="24,0">
      <!-- Top Area: Date above Clock -->
      <StackPanel x:Name="ClockArea"
                  Grid.Row="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Spacing="4"
                  Margin="0,72,0,0"
                  Opacity="0"
                  RenderTransform="translateY(-14px)">

        <TextBlock x:Name="DateText"
                   Text="{DynamicResource Loc_C2A36ACCB9A4}"
                   FontSize="{DynamicResource TypeSizeHeading}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource WhiteAlpha95Brush}"
                   TextWrapping="Wrap" TextAlignment="Center">
          <TextBlock.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Color="Black" Opacity="0.35" />
          </TextBlock.Effect>
        </TextBlock>
        <Grid HorizontalAlignment="Center">
          <TextBlock x:Name="PreviousClockText"
                     FontSize="{DynamicResource TypeSizeDisplayHero}" FontWeight="Bold"
                     HorizontalAlignment="Center" Foreground="{DynamicResource LockScreenMutedBrush}"
                     Opacity="0" IsHitTestVisible="False" />
          <TextBlock x:Name="ClockText"
                     Text="9:41"
                     FontSize="{DynamicResource TypeSizeDisplayHero}"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource LockScreenMutedBrush}" />
        </Grid>
      </StackPanel>

      <!-- Center / Lower Area: User Avatar, Username, Password Box, Subtitle -->
      <StackPanel x:Name="CredentialsPanel"
                  Grid.Row="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Spacing="8"
                  Margin="0,24,0,24"
                  Width="320"
                  Opacity="0"
                  RenderTransform="translateY(14px)">

        <!-- User Avatar with Taskbar Shell Frame Material -->
        <controls:ShellFrameBorder x:Name="AvatarBorder" Width="48"
                Height="48"
                Padding="0"
                Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                CornerRadius="24"
                HorizontalAlignment="Center">
          <controls:ShellFrameBorder BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                  BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}" BackgroundSizing="InnerBorderEdge"
                  Background="Transparent"
                  CornerRadius="24">
            <Border Background="{DynamicResource SurfaceBaseBrush}"
                    CornerRadius="24"
                    ClipToBounds="True">
              <Grid>
                <controls:DaisyIcon Icon="user" IsVisible="{DynamicResource ProfilePictureMissing}"
                                    Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Fill="{DynamicResource ProfilePictureBrush}" />
              </Grid>
            </Border>
          </controls:ShellFrameBorder>
        </controls:ShellFrameBorder>

        <!-- Username -->
        <TextBlock x:Name="UserNameText"
                   Text="{DynamicResource Loc_63E633B951E0}"
                   FontSize="{DynamicResource TypeSizeTitle}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource WhiteAlpha95Brush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,2,0,4">
          <TextBlock.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Color="Black" Opacity="0.35" />
          </TextBlock.Effect>
        </TextBlock>

        <!-- Password Pill Container with Taskbar Shell Frame Material -->
        <controls:ShellFrameBorder x:Name="PasswordPillBorder"
                MinHeight="40"
                Padding="0"
                Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                CornerRadius="20"
                HorizontalAlignment="Center">
          <controls:ShellFrameBorder BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                  BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}" BackgroundSizing="InnerBorderEdge"
                  Background="Transparent"
                  CornerRadius="{Binding CornerRadius, ElementName=PasswordPillBorder}">
            <Border Background="{DynamicResource SurfaceBaseBrush}"
                    CornerRadius="{Binding CornerRadius, ElementName=PasswordPillBorder}"
                    ClipToBounds="True">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="PasswordBox"
                         Grid.Column="0"
                         PasswordChar="•"
                         PlaceholderText="{DynamicResource Loc_3D81652794E5}"
                         FontSize="{DynamicResource TypeSizeBodySmall}"
                         LetterSpacing="0"
                         Height="{DynamicResource ControlHeightStandard}"
                         Padding="16,0,6,0"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         Foreground="{DynamicResource ContentPrimaryBrush}"
                         BorderThickness="0"
                         CornerRadius="{Binding CornerRadius, ElementName=PasswordPillBorder}"
                         VerticalAlignment="Center">
                  <TextBox.Styles>
                    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
                      <Setter Property="FontSize" Value="{DynamicResource TypeSizeBodySmall}" />
                      <Setter Property="LetterSpacing" Value="0" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                  </TextBox.Styles>
                </TextBox>

                <!-- Hint Button (?) -->
                <Button x:Name="HintButton"
                        Grid.Column="1"
                        Classes="Ghost IconButton Small"
                        Margin="0,0,2,0"
                        ToolTip.Tip="{DynamicResource Loc_89D40EFBE503}"
                        Click="OnHintClicked">
                  <TextBlock Text="?"
                             FontSize="{DynamicResource TypeSizeCaption}"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ContentSecondaryBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,-1,0,0" />
                </Button>

                <!-- Submit Arrow Button -->
                <Button x:Name="UnlockButton"
                        Grid.Column="2"
                        Classes="Ghost IconButton Small"
                        Margin="0,0,3,0"
                        Click="OnUnlockClicked">
                  <controls:DaisyIcon x:Name="UnlockArrowIcon"
                                      Icon="arrow-right"
                                      Size="{DynamicResource IconSizeSmall}"
                                      Foreground="{DynamicResource ContentPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Button>
              </Grid>
            </Border>
          </controls:ShellFrameBorder>
        </controls:ShellFrameBorder>

        <!-- Subtitle / Required text -->
        <TextBlock x:Name="SubtitleText" IsVisible="False"
                   Text="{DynamicResource Loc_3D19CD89932C}"
                   FontSize="{DynamicResource TypeSizeCaption}"
                   Foreground="{DynamicResource WhiteAlpha85Brush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   LineHeight="{DynamicResource TypeLineCaption}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0">
          <TextBlock.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Color="Black" Opacity="0.3" />
          </TextBlock.Effect>
        </TextBlock>

        <!-- Error message -->
        <TextBlock x:Name="ErrorMessageText"
                   Text="{DynamicResource Loc_78FA607C01BC}"
                   FontSize="{DynamicResource TypeSizeCaption}"
                   Foreground="{DynamicResource LockScreenDangerBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,4,0,0">
          <TextBlock.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="4" Color="Black" Opacity="0.4" />
          </TextBlock.Effect>
        </TextBlock>

        <!-- Caps lock indicator -->
        <TextBlock x:Name="CapsLockWarningText"
                   Text="{DynamicResource Loc_FE5A64D430AE}"
                   FontSize="{DynamicResource TypeSizeCaption}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource LockScreenWarningBrush}"
                   HorizontalAlignment="Center"
                   IsVisible="False"
                   Margin="0,2,0,0" />
      </StackPanel>
      </Grid>
      </ScrollViewer>

    <!-- Discreet Corner Items: Battery info bottom-left, Power buttons bottom-right -->
    <Grid x:Name="CornerControlsGrid" Grid.Row="1"
          VerticalAlignment="Bottom"
          Margin="24,20"
          IsHitTestVisible="True"
          Opacity="0">
      <controls:BatteryStatusView x:Name="BatteryInfo"
                                  IsVisible="False"
                                  ShowState="True"
                                  LabelFontSize="{DynamicResource TypeSizeCaption}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource WhiteAlpha56Brush}" />

      <StackPanel x:Name="PowerControlsPanel"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <Button x:Name="PowerButton"
                Classes="LauncherUtility"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="40"
                Height="40"
                ToolTip.Tip="{DynamicResource Loc_E40690533ABD}"
                Click="OnPowerButtonClicked">
          <controls:DaisyIcon Icon="power"
                              Size="{DynamicResource IconSizeMedium}"
                              Foreground="{DynamicResource ContentPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </Grid>
    </Grid>

    <controls:ShellFrameBorder x:Name="MenuBlurHost" IsVisible="False" Width="184"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
            CornerRadius="{DynamicResource RoundedLG}" Padding="0"
            BoxShadow="{DynamicResource ElevationFlyoutShadow}" ZIndex="100">
      <controls:ShellFrameBorder Background="{DynamicResource ShellFrameInnerHighlightBrush}"
              CornerRadius="{DynamicResource RoundedLGInset}" Padding="{DynamicResource ShellFrameSurfaceInset}">
        <Border Background="{DynamicResource ContextMenuBackgroundBrush}"
                CornerRadius="{DynamicResource RoundedMD}" Padding="4">
          <StackPanel>
            <MenuItem Header="{DynamicResource Loc_D466BCF52EB6}" Click="OnSleepClicked">
              <MenuItem.Icon>
                <controls:DaisyIcon Icon="moon" Classes="MenuIcon" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_49616145514E}" Click="OnLogOutClicked">
              <MenuItem.Icon>
                <controls:DaisyIcon Icon="sign-out" Classes="MenuIcon" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_6B983A81E5E8}" Click="OnRestartClicked">
              <MenuItem.Icon>
                <controls:DaisyIcon Icon="arrows-clockwise" Classes="MenuIcon" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_A4193461E8AC}" Click="OnShutdownClicked">
              <MenuItem.Icon>
                <controls:DaisyIcon Icon="power" Classes="MenuIcon" />
              </MenuItem.Icon>
            </MenuItem>
          </StackPanel>
        </Border>
      </controls:ShellFrameBorder>
    </controls:ShellFrameBorder>

    <!-- Bottom-Left Large Desktop Media Widget -->
    <Grid x:Name="CollapsedMediaHost"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          Margin="24,0,0,24"
          IsVisible="False">
      <controls:ShellFrameBorder x:Name="CollapsedMediaBorder"
                                 Width="354"
                                 Height="160"
                                 Padding="0"
                                 Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                                 CornerRadius="{DynamicResource RoundedXXL}"
                                 RenderTransformOrigin="0.5,0.5">
        <controls:ShellFrameBorder BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                                   BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}"
                                   BackgroundSizing="InnerBorderEdge"
                                   Background="Transparent"
                                   CornerRadius="{DynamicResource RoundedXXLInset}">
          <Border Background="{DynamicResource SurfaceBaseBrush}"
                  CornerRadius="{DynamicResource RoundedXXLDoubleInset}"
                  ClipToBounds="True">
            <Grid>
              <Border x:Name="CollapsedArtworkTint"
                      Background="Transparent"
                      IsHitTestVisible="False">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationEnter}" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
              </Border>

              <Grid Margin="16" ColumnDefinitions="Auto,*">
                <!-- Clickable Square Album Artwork -->
                <Border x:Name="CollapsedArtworkButton"
                        Grid.Column="0"
                        Classes="LockMediaArtwork"
                        Width="126"
                        Height="126"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        CornerRadius="{DynamicResource RoundedLG}"
                        ClipToBounds="True"
                        Cursor="Hand"
                        Background="Transparent"
                        PointerPressed="OnCollapsedArtworkPointerPressed">
                  <Grid>
                    <Image x:Name="CollapsedArtworkImage"
                           Stretch="UniformToFill"
                           IsVisible="False"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <Border x:Name="CollapsedArtworkFallback"
                            Background="{DynamicResource StateHoverBrush}">
                      <Grid>
                        <Image x:Name="CollapsedSourceIcon"
                               Width="36"
                               Height="36"
                               IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <controls:DaisyIcon x:Name="CollapsedSourceGlyph"
                                            Icon="music-note"
                                            Weight="Fill"
                                            Size="{DynamicResource IconSizeHero}"
                                            Foreground="{DynamicResource ContentTertiaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!-- Right Column: Spectrum, Title/Artist, Transport -->
                <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,*,Auto">
                  <Canvas Grid.Row="0"
                          x:Name="CollapsedSpectrumCanvas"
                          Width="28"
                          Height="28"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          IsHitTestVisible="False" />

                  <StackPanel Grid.Row="1"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Spacing="2">
                    <controls:MarqueeText x:Name="CollapsedTitleText"
                               Text="{DynamicResource Loc_A92C2C9ABECA}"
                               FontSize="{DynamicResource TypeSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentPrimaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="CollapsedArtistText"
                               FontSize="{DynamicResource TypeSizeCaption}"
                               Foreground="{DynamicResource ContentSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                  </StackPanel>

                  <StackPanel Grid.Row="2"
                              Orientation="Horizontal"
                              Spacing="{DynamicResource Space2}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom">
                    <Button x:Name="CollapsedPreviousButton"
                            Classes="LockMediaBtn"
                            Width="{DynamicResource ControlHeightStandard}"
                            Height="{DynamicResource ControlHeightStandard}"
                            Click="OnMediaPreviousClicked"
                            ToolTip.Tip="{DynamicResource Loc_C50A886D0DC5}">
                      <controls:DaisyIcon Icon="rewind"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedium}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                    <Button x:Name="CollapsedPlayPauseButton"
                            Classes="LockMediaBtn"
                            Width="{DynamicResource ControlHeightStandard}"
                            Height="{DynamicResource ControlHeightStandard}"
                            Click="OnMediaPlayPauseClicked"
                            ToolTip.Tip="{DynamicResource Loc_436E61016E26}">
                      <controls:DaisyIcon x:Name="CollapsedPlayPauseGlyph"
                                          Icon="play"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedium}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                    <Button x:Name="CollapsedNextButton"
                            Classes="LockMediaBtn"
                            Width="{DynamicResource ControlHeightStandard}"
                            Height="{DynamicResource ControlHeightStandard}"
                            Click="OnMediaNextClicked"
                            ToolTip.Tip="{DynamicResource Loc_F930A5DF6B51}">
                      <controls:DaisyIcon Icon="fast-forward"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedium}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </controls:ShellFrameBorder>
      </controls:ShellFrameBorder>
    </Grid>

    <!-- Fullscreen Media Mode Overlay (Center Artwork + Bottom Control Card) -->
    <Grid x:Name="ExpandedMediaHost"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsVisible="False">
      <StackPanel x:Name="ExpandedMediaStack"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Spacing="28"
                  Margin="24,0,24,36">
        <!-- Center Large Album Artwork (Click to collapse back to normal lock screen) -->
        <controls:ShellFrameBorder x:Name="ExpandedArtworkContainer"
                Classes="LockMediaArtwork"
                Cursor="Hand"
                PointerPressed="OnExpandedArtworkPointerPressed"
                Width="312"
                Height="312"
                Padding="0"
                HorizontalAlignment="Center"
                Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                CornerRadius="{DynamicResource RoundedXXL}"
                BoxShadow="{DynamicResource LockScreenMediaArtworkShadow}">
          <Panel>
            <Border x:Name="ExpandedArtworkButton"
                    Margin="1"
                    CornerRadius="{DynamicResource RoundedXXLDoubleInset}"
                    ClipToBounds="True"
                    Cursor="Hand"
                    Background="{DynamicResource SurfaceBaseBrush}">
              <Grid>
                <Image x:Name="ExpandedArtworkImage"
                       Stretch="UniformToFill"
                       IsVisible="False"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <Border x:Name="ExpandedArtworkFallback"
                        Background="{DynamicResource SurfaceBaseBrush}">
                  <Grid>
                    <Image x:Name="ExpandedSourceIcon"
                           Width="64"
                           Height="64"
                           IsVisible="False"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <controls:DaisyIcon x:Name="ExpandedSourceGlyph"
                                        Icon="music-note"
                                        Weight="Fill"
                                        Size="{DynamicResource IconSizeArtworkLarge}"
                                        Foreground="{DynamicResource ContentTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <controls:ShellFrameBorder Background="Transparent"
                    BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}"
                    BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                    BackgroundSizing="InnerBorderEdge"
                    CornerRadius="{DynamicResource RoundedXXLInset}"
                    IsHitTestVisible="False" />
          </Panel>
        </controls:ShellFrameBorder>

        <!-- Expanded Media Control Card -->
        <controls:ShellFrameBorder x:Name="ExpandedMediaBorder"
                                   Width="354"
                                   Padding="0"
                                   Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                                   CornerRadius="{DynamicResource RoundedXXL}"
                                   HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
          <controls:ShellFrameBorder BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                                     BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}"
                                     BackgroundSizing="InnerBorderEdge"
                                     Background="Transparent"
                                     CornerRadius="{DynamicResource RoundedXXLInset}">
            <Border Background="{DynamicResource SurfaceBaseBrush}"
                    CornerRadius="{DynamicResource RoundedXXLDoubleInset}"
                    ClipToBounds="True">
              <Grid>
                <Border x:Name="ExpandedArtworkTint" Background="Transparent" IsHitTestVisible="False" />
                <Grid Margin="20,14,20,14"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10">
                  <!-- Row 0: Metadata with reserved space for the spectrum -->
                  <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Margin="0,0,40,0">
                      <controls:MarqueeText x:Name="ExpandedTitleText"
                                 Text="{DynamicResource Loc_A92C2C9ABECA}"
                                 FontSize="{DynamicResource TypeSizeBody}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 TextAlignment="Left"
                                 HorizontalAlignment="Stretch" />
                      <TextBlock x:Name="ExpandedArtistText"
                                 FontSize="{DynamicResource TypeSizeCaption}"
                                 Foreground="{DynamicResource ContentSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 TextAlignment="Left"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Canvas x:Name="ExpandedSpectrumCanvas"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                  </Grid>

                  <!-- Row 1: Scrubber / Timeline with Elapsed and Remaining Time -->
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ExpandedElapsedText"
                               Grid.Column="0"
                               Text="0.00"
                               FontSize="{DynamicResource TypeSizeMicro}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ContentSecondaryBrush}"
                               VerticalAlignment="Center"
                               MinWidth="28" />

                    <Border x:Name="ExpandedProgressHitArea"
                            Grid.Column="1"
                            Background="Transparent"
                            Padding="0,6"
                            Margin="10,0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            PointerPressed="OnProgressTrackPointerPressed">
                      <Border x:Name="ExpandedProgressTrack"
                              Height="6"
                              CornerRadius="3"
                              Background="{DynamicResource WhiteAlpha20Brush}"
                              ClipToBounds="True"
                              HorizontalAlignment="Stretch">
                        <Border x:Name="ExpandedProgressFill"
                                Height="6"
                                CornerRadius="3"
                                Background="{DynamicResource WhiteAlpha85Brush}"
                                HorizontalAlignment="Left"
                                Width="0" />
                      </Border>
                    </Border>

                    <TextBlock x:Name="ExpandedRemainingText"
                               Grid.Column="2"
                               Text="- 0.00"
                               FontSize="{DynamicResource TypeSizeMicro}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ContentSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               MinWidth="34" />
                  </Grid>

                  <!-- Row 2: Transport Buttons -->
                  <StackPanel Grid.Row="2"
                              Orientation="Horizontal"
                              Spacing="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <Button x:Name="ExpandedPreviousButton"
                            Classes="LockMediaBtn"
                            Width="36"
                            Height="36"
                            Click="OnMediaPreviousClicked"
                            ToolTip.Tip="{DynamicResource Loc_C50A886D0DC5}">
                      <controls:DaisyIcon Icon="rewind"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedium}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                    <Button x:Name="ExpandedPlayPauseButton"
                            Classes="LockMediaBtn"
                            Width="40"
                            Height="40"
                            Click="OnMediaPlayPauseClicked"
                            ToolTip.Tip="{DynamicResource Loc_436E61016E26}">
                      <controls:DaisyIcon x:Name="ExpandedPlayPauseGlyph"
                                          Icon="play"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedia}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                    <Button x:Name="ExpandedNextButton"
                            Classes="LockMediaBtn"
                            Width="36"
                            Height="36"
                            Click="OnMediaNextClicked"
                            ToolTip.Tip="{DynamicResource Loc_F930A5DF6B51}">
                      <controls:DaisyIcon Icon="fast-forward"
                                          Weight="Fill"
                                          Size="{DynamicResource IconSizeMedium}"
                                          Foreground="{DynamicResource ContentPrimaryBrush}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </controls:ShellFrameBorder>
        </controls:ShellFrameBorder>
      </StackPanel>
    </Grid>

    <!-- Floating FLIP Hero Artwork Bridge for Smooth Expand/Collapse Transition -->
    <Panel x:Name="MorphingArtworkHost"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           IsHitTestVisible="False">
      <Border x:Name="MorphingArtworkBorder"
              Width="126"
              Height="126"
              Padding="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
              CornerRadius="14"
              BoxShadow="{DynamicResource LockScreenMediaMorphShadow}"
              IsVisible="False"
              IsHitTestVisible="False">
        <Panel>
          <Border x:Name="MorphingArtworkInner"
                  Margin="1"
                  CornerRadius="13"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="MorphingArtworkImage"
                     Stretch="UniformToFill"
                     IsVisible="False"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border x:Name="MorphingArtworkFallback"
                      Background="{DynamicResource StateHoverBrush}">
                <Grid>
                  <Image x:Name="MorphingSourceIcon"
                         Width="44"
                         Height="44"
                         IsVisible="False"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <controls:DaisyIcon x:Name="MorphingSourceGlyph"
                                      Icon="music-note"
                                      Weight="Fill"
                                      Size="{DynamicResource IconSizeArtwork}"
                                      Foreground="{DynamicResource ContentTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Border>
          <Border x:Name="MorphingArtworkHighlight"
                  Background="Transparent"
                  BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}"
                  BorderThickness="{DynamicResource ShellFrameBorderThickness}"
                  CornerRadius="13"
                  IsHitTestVisible="False" />
        </Panel>
      </Border>
    </Panel>

    <controls:DeptEffectPresenter x:Name="DeptForeground" IsHitTestVisible="False" />
  </Grid>
</Window>
