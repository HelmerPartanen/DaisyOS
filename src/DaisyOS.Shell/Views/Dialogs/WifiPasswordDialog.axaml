<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
        x:Class="DaisyOS.Shell.Views.Dialogs.WifiPasswordDialog"
        Title="{DynamicResource Loc_0ADE08BC3EEE}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True">

  <controls:ShellFrameBorder Margin="{DynamicResource SpaceInset4}"
          Background="{DynamicResource ShellFrameOuterEdgeBrush}"
          CornerRadius="{DynamicResource RadiusDialog}"
          Padding="{DynamicResource BorderThicknessDefault}"
          BoxShadow="{DynamicResource ElevationDialogShadow}">
    <controls:ShellFrameBorder Background="{DynamicResource ShellFrameInnerHighlightBrush}"
            CornerRadius="{DynamicResource RadiusSurfaceInner}"
            Padding="{DynamicResource BorderThicknessDefault}">
      <Border Background="{DynamicResource SurfaceBaseBrush}"
              CornerRadius="{DynamicResource RoundedLG}"
              Padding="{DynamicResource SpaceInset6}">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,20">
            <Border Grid.Column="0"
                    Width="44"
                    Height="44"
                    CornerRadius="{DynamicResource RadiusCircle}"
                    Background="{DynamicResource SurfaceRaisedSubtleBrush}"
                    Margin="0,0,16,0">
              <controls:WifiSignalIcon x:Name="WifiIcon"
                                       Width="{DynamicResource IconSizeLarge}"
                                       Height="{DynamicResource IconSizeLarge}"
                                       SignalPercent="100"
                                       ActiveBrush="{DynamicResource ActionPrimaryBrush}"
                                       InactiveBrush="{DynamicResource ContentTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SsidText"
                         Text="{DynamicResource Loc_07367EE22582}"
                         FontSize="{DynamicResource TypeSizeBodyLarge}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource ContentPrimaryBrush}" />
              <TextBlock x:Name="SecurityText"
                         Text="{DynamicResource Loc_0AF0D263BAA6}"
                         FontSize="{DynamicResource TypeSizeCaption}"
                         Foreground="{DynamicResource ContentSecondaryBrush}"
                         Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <!-- Input Body -->
          <StackPanel Grid.Row="1" Spacing="{DynamicResource Space3}" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Loc_BC62D372466A}"
                       FontSize="{DynamicResource TypeSizeBodySmall}"
                       Foreground="{DynamicResource ContentPrimaryBrush}" />

            <TextBox x:Name="PasswordBox"
                     AutomationProperties.Name="{DynamicResource Loc_0EA8C0E4ABFA}"
                     PasswordChar="•"
                     PlaceholderText="{DynamicResource Loc_E7CF3EF4F17C}"
                     FontSize="{DynamicResource TypeSizeBodySmall}"
                     CornerRadius="{DynamicResource RadiusControlInner}"
                     MinHeight="{DynamicResource InputHeightStandard}"
                     Padding="{DynamicResource ControlPaddingHorizontal}" />

            <CheckBox x:Name="ShowPasswordCheckBox"
                      Content="{DynamicResource Loc_6AEAA6A53D09}"
                      FontSize="{DynamicResource TypeSizeCaption}"
                      Margin="0,2,0,0" />

            <TextBlock x:Name="StatusMessageText"
                       FontSize="{DynamicResource TypeSizeCaption}"
                       Foreground="{DynamicResource StatusDangerBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Margin="0,4,0,0" />
          </StackPanel>

          <!-- Footer Buttons -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,0">
            <!-- Progress indicator -->
            <ProgressBar x:Name="ConnectingProgress"
                         Grid.Column="0"
                         IsIndeterminate="True"
                         Height="4"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         IsVisible="False" />

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="{DynamicResource Loc_19766ED6CCB2}"
                    IsCancel="True"
                    Classes="Secondary"
                    MinWidth="88"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,8,0"
                    Click="OnCancelClicked" />

            <Button x:Name="ConnectButton"
                    Grid.Column="2"
                    Content="{DynamicResource Loc_1A2303EDE074}"
                    IsDefault="True"
                    Classes="Primary"
                    MinWidth="100"
                    HorizontalContentAlignment="Center"
                    Click="OnConnectClicked" />
          </Grid>
        </Grid>
      </Border>
    </controls:ShellFrameBorder>
  </controls:ShellFrameBorder>
</Window>
