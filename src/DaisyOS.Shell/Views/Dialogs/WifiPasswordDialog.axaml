<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
        x:Class="DaisyOS.Shell.Views.Dialogs.WifiPasswordDialog"
        Title="{DynamicResource Loc_0ADE08BC3EEE}"
        Width="{DynamicResource DialogWidthStandard}"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="Full"
        Background="{DynamicResource SurfaceBaseSolidBrush}"
        ShowInTaskbar="False">

  <Grid Margin="{DynamicResource DialogContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource DialogSectionSpacing}">

    <!-- Network identity. WifiSignalIcon is shared with the system bar and
         quick settings, so signal strength and band geometry stay consistent. -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="{DynamicResource Space3}">
      <Border Width="{DynamicResource DialogHeaderIconSize}"
              Height="{DynamicResource DialogHeaderIconSize}"
              CornerRadius="{DynamicResource RadiusControl}"
              Background="{DynamicResource StateSelectedBrush}">
        <controls:WifiSignalIcon x:Name="WifiIcon"
                                 Width="{DynamicResource IconSizeLarge}"
                                 Height="{DynamicResource IconSizeLarge}"
                                 SignalPercent="100"
                                 ActiveBrush="{DynamicResource ActionPrimaryBrush}"
                                 InactiveBrush="{DynamicResource ContentDisabledBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
      </Border>

      <StackPanel Grid.Column="1"
                  Spacing="{DynamicResource Space1}"
                  VerticalAlignment="Center">
        <TextBlock x:Name="SsidText"
                   Text="{DynamicResource Loc_07367EE22582}"
                   FontSize="{DynamicResource TypeSizeTitle}"
                   FontWeight="SemiBold"
                   LineHeight="{DynamicResource TypeLineTitle}"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource ContentPrimaryBrush}" />
        <TextBlock x:Name="SecurityText"
                   Text="{DynamicResource Loc_0AF0D263BAA6}"
                   FontSize="{DynamicResource TypeSizeBodySmall}"
                   LineHeight="{DynamicResource TypeLineBodySmall}"
                   Foreground="{DynamicResource ContentSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- Shared TextBox and CheckBox themes provide hover, focus, disabled,
         typography, and accessibility states without dialog-local styles. -->
    <StackPanel Grid.Row="1" Spacing="{DynamicResource Space2}">
      <TextBlock Text="{DynamicResource Loc_BC62D372466A}"
                 FontSize="{DynamicResource TypeSizeBodySmall}"
                 FontWeight="Medium"
                 Foreground="{DynamicResource ContentPrimaryBrush}" />

      <TextBox x:Name="PasswordBox"
               AutomationProperties.Name="{DynamicResource Loc_0EA8C0E4ABFA}"
               PasswordChar="•"
               PlaceholderText="{DynamicResource Loc_E7CF3EF4F17C}" />

      <CheckBox x:Name="ShowPasswordCheckBox"
                Content="{DynamicResource Loc_6AEAA6A53D09}" />

      <Border x:Name="StatusMessageContainer"
              IsVisible="False"
              Background="{DynamicResource StatusDangerContainerBrush}"
              CornerRadius="{DynamicResource RadiusControl}"
              Padding="{DynamicResource SpaceInset3}">
        <TextBlock x:Name="StatusMessageText"
                   FontSize="{DynamicResource TypeSizeBodySmall}"
                   LineHeight="{DynamicResource TypeLineBodySmall}"
                   Foreground="{DynamicResource StatusDangerBrush}"
                   TextWrapping="Wrap"
                   IsVisible="False" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Space3}">
      <ProgressBar x:Name="ConnectingProgress"
                   Grid.Row="0"
                   IsIndeterminate="True"
                   Height="4"
                   IsVisible="False" />

      <!-- Primary/Secondary are the reusable DaisyOS button variants. -->
      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{DynamicResource DialogActionSpacing}">
        <Button x:Name="CancelButton"
                Content="{DynamicResource Loc_19766ED6CCB2}"
                IsCancel="True"
                Classes="Secondary"
                MinWidth="{DynamicResource DialogButtonMinWidth}"
                Click="OnCancelClicked" />

        <Button x:Name="ConnectButton"
                Content="{DynamicResource Loc_1A2303EDE074}"
                IsDefault="True"
                Classes="Primary"
                MinWidth="{DynamicResource DialogButtonMinWidth}"
                Click="OnConnectClicked" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
