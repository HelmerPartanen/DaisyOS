<Window
    x:Class="DaisyOS.Shell.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:DaisyOS.Shell.Views"
    Title="{DynamicResource Loc_79428390EC38}"
    WindowState="FullScreen"
    WindowDecorations="None"
    TextOptions.TextRenderingMode="Antialias"
    Background="Black">
    <Grid>
        <views:ShellView x:Name="Shell" />
    </Grid>
</Window>
