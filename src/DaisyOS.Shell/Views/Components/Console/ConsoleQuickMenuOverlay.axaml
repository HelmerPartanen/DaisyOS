<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleQuickMenuOverlay"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
    xmlns:local="clr-namespace:DaisyOS.Shell.Views.Components.Console"
    IsVisible="False"
    IsHitTestVisible="False"
    Opacity="0"
    ZIndex="800"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationSlow}" Easing="CubicEaseOut" />
    </Transitions>
  </UserControl.Transitions>

  <UserControl.Styles>
    <Style Selector="controls|DaisyIcon.QuickIcon">
      <Setter Property="Size" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|DaisyIcon.StatusIcon">
      <Setter Property="Size" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <!-- Premium Side Panel Pill Button Style -->
    <Style Selector="Button.SidePanelActionBtn">
      <Setter Property="Height" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="3"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Margin="-4"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.SidePanelActionBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.SidePanelActionBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Recent Game Horizontal Button Style -->
    <Style Selector="Button.RecentGameBtn">
      <Setter Property="Width" Value="130" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="3"
                    CornerRadius="{DynamicResource RadiusSurfaceInner}"
                    Margin="-4"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.RecentGameBtn:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.RecentGameBtn:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Darkened Backdrop -->
  <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      
      <!-- Edge Indicator Pill (Exactly 75% height of the panel via 1*, 6*, 1* rows) -->
      <Grid Grid.Column="0" RowDefinitions="1*, 6*, 1*">
        <Border Grid.Row="1" 
                Width="6" 
                CornerRadius="{DynamicResource RadiusSmall}"
                Background="{DynamicResource ContentSecondaryBrush}" />
      </Grid>

      <!-- Floating Dashboard Island -->
      <Border Grid.Column="2"
              Width="460" 
              Background="{DynamicResource SurfaceBaseBrush}"
              CornerRadius="{DynamicResource RadiusPill}"
              BorderBrush="{DynamicResource StrokeDefaultBrush}"
              BorderThickness="1"
              BoxShadow="{DynamicResource ElevationDialogShadow}"
              ClipToBounds="False">
        
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="24">
        
        <!-- HEADER (System Status, Clock, Battery, Wifi) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
          <TextBlock Grid.Column="0" x:Name="SystemStatusDescription" Text="{DynamicResource Loc_CD142B5CB554}" FontSize="{DynamicResource TypeSizeBody}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
          
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <controls:DaisyIcon Icon="wifi-high" Classes="StatusIcon" />
            <controls:DaisyIcon Icon="battery-full" Classes="StatusIcon" />
            <TextBlock x:Name="ClockText" Text="00:00" FontSize="{DynamicResource TypeSizeBody}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- MAIN DASHBOARD CONTENT -->
        <StackPanel Grid.Row="1" Spacing="32" Margin="4,4,4,16" ClipToBounds="False">
          
          <!-- 1. QUICK ACTIONS GRID -->
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ClipToBounds="False">
            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnGoHome" Classes="SidePanelActionBtn" Margin="0,0,8,8" Click="OnGoHomeClicked">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <controls:DaisyIcon Icon="house" Classes="QuickIcon"/>
                <TextBlock Text="{DynamicResource Loc_82BC39F68192}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            
            <Button Grid.Row="0" Grid.Column="1" x:Name="BtnExitDesktop" Classes="SidePanelActionBtn" Margin="8,0,0,8" Click="OnQuickReturnDesktopClicked">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <controls:DaisyIcon Icon="desktop" Classes="QuickIcon"/>
                <TextBlock Text="{DynamicResource Loc_9BD88F2485AC}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            
            <Button Grid.Row="1" Grid.Column="0" x:Name="BtnRestart" Classes="SidePanelActionBtn" Margin="0,8,8,0" Click="OnQuickRestartClicked">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <controls:DaisyIcon Icon="arrow-counter-clockwise" Classes="QuickIcon"/>
                <TextBlock Text="{DynamicResource Loc_6B983A81E5E8}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            
            <Button Grid.Row="1" Grid.Column="1" x:Name="BtnPowerOff" Classes="SidePanelActionBtn" Margin="8,8,0,0" Click="OnQuickShutdownClicked">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <controls:DaisyIcon Icon="power" Classes="QuickIcon"/>
                <TextBlock Text="{DynamicResource Loc_2C8D5531091C}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- 2. SLIDERS (VOLUME & MIC) -->
          <StackPanel Spacing="16" ClipToBounds="False">
            <TextBlock Text="{DynamicResource Loc_E19D580C11BA}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" Margin="4,0,0,0"/>
            <controls:ConsolePillSlider x:Name="QuickMasterVolumeSlider" Icon="speaker-high" Value="50" ValueChanged="OnQuickMasterVolumeChanged" />
            <controls:ConsolePillSlider x:Name="QuickMicVolumeSlider" Icon="microphone" Value="50" ValueChanged="OnQuickMicVolumeChanged" />
          </StackPanel>

          <!-- 3. MEDIA WIDGET -->
          <StackPanel Spacing="16" ClipToBounds="False">
            <TextBlock Text="{DynamicResource Loc_8B2AE991573C}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" Margin="4,0,0,0"/>
            <!-- Stretched horizontally -->
            <local:ConsoleMediaWidget x:Name="PanelMediaWidget" HorizontalAlignment="Stretch" Margin="0" />
          </StackPanel>

          <!-- 4. CURRENT GAME -->
          <StackPanel x:Name="CurrentGamePanel" Spacing="16" ClipToBounds="False" IsVisible="False">
            <Border BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,-16,0,0"/>

            <TextBlock Text="{DynamicResource Loc_9FDD72191076}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" Margin="4,0,0,0"/>

            <!-- Game Info Row -->
            <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,0">
              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Background="{DynamicResource SurfaceSunkenBrush}">
                <Image x:Name="CurrentGameIcon" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                <TextBlock x:Name="CurrentGameTitle" Text="{DynamicResource Loc_7ED271AD68A4}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource ContentPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock Text="{DynamicResource Loc_F4CCAE29E1BB}" FontSize="{DynamicResource TypeSizeBodySmall}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- Action Buttons Grid -->
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" x:Name="BtnRestartGame" Classes="SidePanelActionBtn" Margin="0,0,6,0" Click="OnRestartGameClicked">
                <TextBlock Text="{DynamicResource Loc_0E0665255667}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button Grid.Column="1" x:Name="BtnCloseGame" Classes="SidePanelActionBtn" Margin="6,0,0,0" Click="OnCloseGameClicked">
                <TextBlock Text="{DynamicResource Loc_51B0451EE87B}" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
            </Grid>
          </StackPanel>

        </StackPanel>

        <!-- FOOTER: CONTROLLER HINTS -->
        <Border Grid.Row="2" Padding="0,24,0,0" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintCategoryDpadImage" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Loc_5EA5FBE811DB}" FontSize="{DynamicResource TypeSizeBody}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintConfirmImage" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Loc_2A78025DE6AA}" FontSize="{DynamicResource TypeSizeBody}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image x:Name="HintBackImage" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Loc_7D9EB7ACB13E}" FontSize="{DynamicResource TypeSizeBody}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

      </Grid>
    </Border>
    </Grid>
  </Grid>

</UserControl>
