<UserControl
    x:Class="DaisyOS.Shell.Views.Components.Console.ConsoleHeaderBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DaisyOS.Shell.Views.Components.Console"
    xmlns:controls="clr-namespace:DaisyOS.Shell.Controls">

  <UserControl.Styles>
    <!-- Top Header Tab Navigation Buttons -->
    <Style Selector="Button.ConsoleHeaderNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <!-- Outer Offsetted White Outline Ring (5px gap, 25px CornerRadius) -->
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <!-- Main Inner Pill ContentPresenter -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNav TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- State 1: Active Tab -> Solid White Pill, Solid Black Text, NO GLOW -->
    <Style Selector="Button.ConsoleHeaderNav.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 2: Focused State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <!-- Ensure Active Focused Text stays solid black on the white pill -->
    <Style Selector="Button.ConsoleHeaderNav.Active:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentOnActionBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- State 3: Hover State -> Show Outer Offsetted White Ring -->
    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNav:pointerover:not(.Active) TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <Setter Property="Template">
        <ControlTemplate>
          <Panel ClipToBounds="False">
            <Border x:Name="PART_FocusRing"
                    BorderBrush="{DynamicResource ActionPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusSurface}"
                    Margin="-5"
                    Opacity="0"
                    ClipToBounds="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ClipToBounds="True">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover /template/ Border#PART_FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:focus TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ConsoleHeaderNavIcon:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>

    <Style Selector="controls|DaisyIcon.ConsoleStatusIcon">
      <Setter Property="Size" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Top System Bar Header -->
  <Grid ColumnDefinitions="1*,Auto,1*" VerticalAlignment="Top" Margin="0,0,0,16" ZIndex="20" ClipToBounds="False">
    
    <!-- Left Media Widget -->
    <local:ConsoleMediaWidget x:Name="HeaderMediaWidget" Grid.Column="0" HorizontalAlignment="Left" Margin="16,0,0,0" />

    <!-- Header Navigation Tabs -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="8,8" ClipToBounds="False" HorizontalAlignment="Center">
      
      <Button x:Name="HeaderRecentButton" Classes="ConsoleHeaderNav Active" Click="OnHeaderRecentClicked" ToolTip.Tip="{DynamicResource Loc_41A86988751A}">
        <TextBlock Text="{DynamicResource Loc_41A86988751A}" />
      </Button>

      <Button x:Name="HeaderLibraryButton" Classes="ConsoleHeaderNav" Click="OnHeaderLibraryClicked" ToolTip.Tip="{DynamicResource Loc_DC20B3D5D2CD}">
        <TextBlock Text="{DynamicResource Loc_DC20B3D5D2CD}" />
      </Button>

    </StackPanel>

    <!-- Right System Status Icons & Settings Gear -->
    <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,8" ClipToBounds="False" HorizontalAlignment="Right">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="False">
        <controls:DaisyIcon Icon="wifi-high" Classes="ConsoleStatusIcon" VerticalAlignment="Center" />
        <controls:DaisyIcon Icon="battery-full" Classes="ConsoleStatusIcon" VerticalAlignment="Center" />
        <TextBlock x:Name="ClockText" Text="20:18" FontSize="{DynamicResource TypeSizeBodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource ContentPrimaryBrush}" VerticalAlignment="Center" />

        <!-- Settings Gear Icon Button -->
        <Button x:Name="HeaderSettingsIconButton" Classes="ConsoleHeaderNavIcon" Click="OnSettingsButtonClicked" ToolTip.Tip="{DynamicResource Loc_74A883A037BC}">
          <controls:DaisyIcon Icon="gear-six" Classes="ConsoleStatusIcon" Size="{DynamicResource IconSizeMedium}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
