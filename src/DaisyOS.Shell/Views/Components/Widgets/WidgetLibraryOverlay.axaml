<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:DaisyOS.Shell.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DaisyOS.Shell.Views.Components.Widgets.WidgetLibraryOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" Focusable="True" PointerPressed="OnBackdropPointerPressed">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DaisyOS.Shell/Themes/WidgetChromeButtonTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.WidgetLibraryFrame">
      <Setter Property="Background" Value="{DynamicResource ShellFrameOuterEdgeBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXL}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationShellDialogShadow}" />
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style Selector="Border.WidgetLibraryHighlight">
      <Setter Property="Background" Value="{DynamicResource ShellFrameInnerHighlightBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXLInset}" />
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style Selector="Border.WidgetLibraryCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceModalGlassBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXLDoubleInset}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Button.CategoryButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Padding" Value="{DynamicResource ControlPaddingHorizontal}" />
      <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeBodySmall}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.CategoryButton TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="Button.CategoryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.CategoryButton.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Border.PreviewCard">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="TextBlock.WidgetGalleryTitle">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.VariantTitle">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.WidgetGalleryHint">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.SizeBadge">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Border.SizeBadge TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
    </Style>
    <Style Selector="Button.CarouselNav">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCircle}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ZIndex" Value="500" />
      <Setter Property="Theme" Value="{StaticResource WidgetChromeButtonTheme}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.CarouselNav /template/ Border#WidgetButtonSurface">
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationFlyoutShadow}" />
    </Style>
    <Style Selector="Button.CarouselNav:disabled">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.PageDot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
      <Setter Property="Background" Value="{DynamicResource ContentTertiaryBrush}" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MotionDurationSlow}" Easing="{StaticResource MotionEaseMove}" />
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationSlow}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.PageDot.Active">
      <Setter Property="Width" Value="20" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <controls:ShellFrameBorder Classes="WidgetLibraryFrame" Width="860" Height="540" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,58" x:Name="LibraryFrame">
      <controls:ShellFrameBorder Classes="WidgetLibraryHighlight">
        <Border x:Name="LibraryCard" Classes="WidgetLibraryCard">
          <Grid ColumnDefinitions="168,*" ColumnSpacing="20">
            <!-- Families -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Widget Gallery" Classes="WidgetGalleryTitle" />
                <TextBlock Text="Swipe to compare sizes." Classes="WidgetGalleryHint" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                <Button x:Name="ClockCategoryButton" Classes="CategoryButton Active" Click="OnClockCategoryClicked">
                  <Grid ColumnDefinitions="24,*">
                    <controls:DaisyIcon Icon="clock" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource AccentOptionOrangeBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource Loc_93FF9273DE4B}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button x:Name="CalendarCategoryButton" Classes="CategoryButton" Click="OnCalendarCategoryClicked">
                  <Grid ColumnDefinitions="24,*">
                    <controls:DaisyIcon Icon="calendar" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource AccentOptionRedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource Loc_D5D0A30B517E}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button x:Name="MediaCategoryButton" Classes="CategoryButton" Click="OnMediaCategoryClicked">
                  <Grid ColumnDefinitions="24,*">
                    <controls:DaisyIcon Icon="music-note" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource AccentOptionPinkBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource Loc_D357175CFE89}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button x:Name="PhotosCategoryButton" Classes="CategoryButton" Click="OnPhotosCategoryClicked">
                  <Grid ColumnDefinitions="24,*">
                    <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource FileLocationPicturesBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource Loc_5E3147AB51E0}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
              <Button Grid.Row="2" x:Name="AddToShelfButton" Classes="CategoryButton" IsVisible="False" Click="OnAddMediaToBottomShelfClicked">
                <Grid ColumnDefinitions="24,*">
                  <controls:DaisyIcon Icon="arrow-down-left" Size="{DynamicResource IconSizeStandard}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource Loc_0C9E7986206D}" FontSize="{DynamicResource TypeSizeCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
            </Grid>
            <!-- Stage: one variant at a time -->
            <Grid Grid.Column="1" x:Name="PreviewArea" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
              <StackPanel x:Name="VariantHeader" Spacing="4" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <TextBlock x:Name="VariantTitle" Classes="VariantTitle" VerticalAlignment="Center" />
                  <Border Classes="SizeBadge" VerticalAlignment="Center"><TextBlock x:Name="VariantSizeText" /></Border>
                </StackPanel>
                <TextBlock x:Name="VariantDescription" Classes="WidgetGalleryHint" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" />
              </StackPanel>
              <Grid Grid.Row="1" x:Name="CarouselViewport" ClipToBounds="True" Background="Transparent">
                <Grid x:Name="CarouselTrack" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="PreviousVariantButton" Classes="CarouselNav" HorizontalAlignment="Left" Margin="4,0,0,0" Click="OnPreviousVariantClicked" ToolTip.Tip="Previous size">
                  <controls:DaisyIcon Icon="caret-left" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                </Button>
                <Button x:Name="NextVariantButton" Classes="CarouselNav" HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnNextVariantClicked" ToolTip.Tip="Next size">
                  <controls:DaisyIcon Icon="caret-right" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                </Button>
              </Grid>
              <StackPanel Grid.Row="2" x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" Height="10" />
              <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*">
                <Button Grid.Column="1" x:Name="AddWidgetButton" Classes="Primary Medium" MinWidth="200" Click="OnAddWidgetClicked">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:DaisyIcon Icon="add-circle" Size="{DynamicResource IconSizeStandard}" VerticalAlignment="Center" />
                    <TextBlock Text="Add Widget" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="Ghost Small" HorizontalAlignment="Right" Content="{DynamicResource Loc_11A6767D5674}" Click="OnDoneClicked" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </controls:ShellFrameBorder>
    </controls:ShellFrameBorder>
  </Grid>
</UserControl>
