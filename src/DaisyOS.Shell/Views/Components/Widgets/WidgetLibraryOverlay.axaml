<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="clr-namespace:DaisyOS.Shell.Controls" xmlns:desktopWidgets="clr-namespace:DaisyOS.Shell.DesktopWidgets" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DaisyOS.Shell.Views.Components.Widgets.WidgetLibraryOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="OnBackdropPointerPressed">
  <UserControl.Styles>
    <Style Selector="Border.WidgetLibraryFrame">
      <Setter Property="Background" Value="{DynamicResource ShellFrameOuterEdgeBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXL}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationShellDialogShadow}" />
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style Selector="Border.WidgetLibraryHighlight">
      <Setter Property="Background" Value="{DynamicResource ShellFrameInnerHighlightBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXLInset}" />
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style Selector="Border.WidgetLibraryCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceModalGlassBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXLDoubleInset}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Button.CategoryButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedMD}" />
      <Setter Property="Padding" Value="{DynamicResource ControlPaddingHorizontal}" />
      <Setter Property="Height" Value="{DynamicResource ControlHeightStandard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeBodySmall}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.CategoryButton TextBlock, Button.CategoryButton.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="Button.CategoryButton controls|DaisyIcon, Button.CategoryButton.Active controls|DaisyIcon">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
    </Style>
    <Style Selector="Button.CategoryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.CategoryButton.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Border.PreviewCard">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedXXL}" />
      <Setter Property="RenderTransform" Value="scale(1.0)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationBase}" Easing="QuadraticEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource MotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.PreviewCard:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.01)" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
    </Style>
  </UserControl.Styles>
  <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <controls:ShellFrameBorder Classes="WidgetLibraryFrame" Width="820" Height="480" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,58" x:Name="LibraryFrame">
      <controls:ShellFrameBorder Classes="WidgetLibraryHighlight">
        <Border x:Name="LibraryCard" Classes="WidgetLibraryCard">
          <Grid RowDefinitions="*,Auto" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="160,*" ColumnSpacing="24">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top">
                <Button x:Name="ClockCategoryButton" Classes="CategoryButton Active" Click="OnClockCategoryClicked">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:DaisyIcon Icon="clock" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_93FF9273DE4B}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="CalendarCategoryButton" Classes="CategoryButton" Click="OnCalendarCategoryClicked">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:DaisyIcon Icon="calendar" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_D5D0A30B517E}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="MediaCategoryButton" Classes="CategoryButton" Click="OnMediaCategoryClicked">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:DaisyIcon Icon="music-note" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_D357175CFE89}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="PhotosCategoryButton" Classes="CategoryButton" Click="OnPhotosCategoryClicked">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_5E3147AB51E0}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <Grid Grid.Column="1" x:Name="PreviewArea">
                <Grid x:Name="ClockPreviewsPanel" ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" IsVisible="True" ColumnSpacing="16">
                  <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnClockSweepPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Viewbox Stretch="Uniform">
                        <Grid Width="222" Height="176">
                          <desktopWidgets:ClockWidget />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_3E0AF27D2BF9}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                  <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnClockDigitalPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Viewbox Stretch="Uniform">
                        <Grid Width="222" Height="176">
                          <desktopWidgets:DigitalClockWidget />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_68B82C427301}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                  <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnClockAnalogPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Viewbox Stretch="Uniform">
                        <Grid Width="222" Height="176">
                          <desktopWidgets:AnalogClockWidget />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_AC1EE367E355}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                </Grid>
                <Grid x:Name="CalendarPreviewsPanel" ColumnDefinitions="3*,4*" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" IsVisible="False" ColumnSpacing="16">
                  <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnCalendarMediumPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Viewbox Stretch="Uniform">
                        <Grid Width="222" Height="176">
                          <desktopWidgets:CalendarWidget x:Name="MediumCalendarPreview" />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_8E588CD18774}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                  <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnCalendarLargePressed" Tag="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Viewbox Stretch="Uniform">
                        <Grid Width="296" Height="176">
                          <desktopWidgets:CalendarWidget x:Name="LargeCalendarPreview" />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_AB80540D98D2}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                </Grid>
                <Grid x:Name="MediaPreviewsPanel" RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" IsVisible="False" RowSpacing="16">
                  <Button Grid.Row="0" Classes="CategoryButton" HorizontalAlignment="Left" Margin="0" Padding="{DynamicResource ControlPaddingHorizontal}" Click="OnAddMediaToBottomShelfClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <controls:DaisyIcon Icon="arrow-down-left" Size="{DynamicResource IconSizeStandard}" Foreground="{DynamicResource ContentPrimaryBrush}" />
                      <TextBlock Text="{DynamicResource Loc_0C9E7986206D}" FontWeight="SemiBold" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Grid Grid.Row="1" ColumnDefinitions="3*,5*" ColumnSpacing="16">
                    <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                      <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnMediaMediumPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                        <Viewbox Stretch="Uniform">
                          <Grid Width="222" Height="176">
                            <controls:WidgetContainer ColumnSpan="3" RowSpan="2" Padding="0">
                              <Grid Background="{DynamicResource StateHoverBrush}">
                                <Border Background="{DynamicResource SurfaceCardBrush}" Opacity="0.6" />
                                <controls:DaisyIcon Icon="music-note" Weight="Fill" Size="{DynamicResource IconSizeHero}" Foreground="{DynamicResource ContentSecondaryBrush}" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border VerticalAlignment="Bottom" Height="76" IsHitTestVisible="False">
                                  <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                      <GradientStop Color="#00000000" Offset="0" />
                                      <GradientStop Color="#90000000" Offset="1" />
                                    </LinearGradientBrush>
                                  </Border.Background>
                                </Border>
                                <Grid VerticalAlignment="Bottom" Margin="14,12" ColumnDefinitions="*,Auto">
                                  <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="88" Height="12" CornerRadius="4" Background="White" Opacity="0.6" HorizontalAlignment="Left" />
                                    <Border Width="56" Height="8" CornerRadius="3" Background="White" Opacity="0.38" HorizontalAlignment="Left" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                    <Border Width="2" Height="6" CornerRadius="1" Background="White" Opacity="0.5" />
                                    <Border Width="2" Height="14" CornerRadius="1" Background="White" Opacity="0.5" />
                                    <Border Width="2" Height="10" CornerRadius="1" Background="White" Opacity="0.5" />
                                    <Border Width="2" Height="16" CornerRadius="1" Background="White" Opacity="0.5" />
                                    <Border Width="2" Height="7" CornerRadius="1" Background="White" Opacity="0.5" />
                                  </StackPanel>
                                </Grid>
                              </Grid>
                            </controls:WidgetContainer>
                          </Grid>
                        </Viewbox>
                      </Border>
                      <TextBlock Text="{DynamicResource Loc_8E588CD18774}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                    </Grid>
                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" RowDefinitions="*,Auto" RowSpacing="12">
                      <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnMediaLargePressed" Tag="5,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                        <Viewbox Stretch="Uniform">
                          <Grid Width="370" Height="176">
                            <controls:WidgetContainer ColumnSpan="5" RowSpan="2" Padding="0">
                              <Grid Margin="14" ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="128" Height="128" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="{DynamicResource RoundedMD}" ClipToBounds="True" Background="{DynamicResource StateHoverBrush}" BoxShadow="0 2 8 0 #20000000">
                                  <controls:DaisyIcon Icon="music-note" Weight="Fill" Size="{DynamicResource IconSizeHero}" Foreground="{DynamicResource ContentSecondaryBrush}" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Column="1" Margin="14,2,0,2" RowDefinitions="Auto,*,Auto">
                                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border Width="2" Height="6" CornerRadius="1" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.4" />
                                    <Border Width="2" Height="14" CornerRadius="1" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.4" />
                                    <Border Width="2" Height="10" CornerRadius="1" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.4" />
                                    <Border Width="2" Height="16" CornerRadius="1" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.4" />
                                    <Border Width="2" Height="7" CornerRadius="1" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.4" />
                                  </StackPanel>
                                  <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="90" Height="11" CornerRadius="4" Background="{DynamicResource ContentPrimaryBrush}" Opacity="0.45" HorizontalAlignment="Center" />
                                    <Border Width="60" Height="8" CornerRadius="3" Background="{DynamicResource ContentSecondaryBrush}" Opacity="0.3" HorizontalAlignment="Center" />
                                  </StackPanel>
                                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                    <Grid Width="40" Height="40">
                                      <controls:DaisyIcon Icon="rewind" Weight="Fill" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Width="40" Height="40">
                                      <controls:DaisyIcon Icon="pause" Weight="Fill" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Width="40" Height="40">
                                      <controls:DaisyIcon Icon="fast-forward" Weight="Fill" Size="{DynamicResource IconSizeMedium}" Foreground="{DynamicResource ContentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                  </StackPanel>
                                </Grid>
                              </Grid>
                            </controls:WidgetContainer>
                          </Grid>
                        </Viewbox>
                      </Border>
                      <TextBlock Text="{DynamicResource Loc_AB80540D98D2}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                    </Grid>
                  </Grid>
                </Grid>
                <Grid x:Name="PhotosPreviewsPanel" ColumnDefinitions="4*,5*" RowDefinitions="*,*" ColumnSpacing="16" RowSpacing="16" IsVisible="False">
                  <Grid RowDefinitions="*,Auto" RowSpacing="8" Grid.Column="0" Grid.Row="0">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnPhotosMediumPressed" Tag="3,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RoundedXXL}"
                              ToolTip.Tip="{DynamicResource Loc_8438AB4A44E5}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="12">
                          <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeHero}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                          <TextBlock Text="{DynamicResource Loc_640775CB2E83}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_8E588CD18774}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                  <Grid RowDefinitions="*,Auto" RowSpacing="8" Grid.Column="0" Grid.Row="1">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnPhotosLargePressed" Tag="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RoundedXXL}"
                              ToolTip.Tip="{DynamicResource Loc_8438AB4A44E5}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="12">
                          <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeHero}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                          <TextBlock Text="{DynamicResource Loc_640775CB2E83}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_AB80540D98D2}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                  <Grid RowDefinitions="*,Auto" RowSpacing="8" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                    <Border Classes="PreviewCard" CornerRadius="{DynamicResource RoundedXXL}" ClipToBounds="True" PointerPressed="OnPhotosExtraLargePressed" Tag="5,4" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RoundedXXL}"
                              ToolTip.Tip="{DynamicResource Loc_8438AB4A44E5}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="12">
                          <controls:DaisyIcon Icon="image" Size="{DynamicResource IconSizeHero}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                          <TextBlock Text="{DynamicResource Loc_640775CB2E83}" FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_CC16912B3B97}" FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource ContentSecondaryBrush}" HorizontalAlignment="Center" Grid.Row="1" />
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Right">
              <Button Classes="Primary Small" Content="{DynamicResource Loc_11A6767D5674}" Click="OnDoneClicked" />
            </Grid>
          </Grid>
        </Border>
      </controls:ShellFrameBorder>
    </controls:ShellFrameBorder>
  </Grid>
</UserControl>