<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DaisyOS.Shell.Controls"
             xmlns:vm="clr-namespace:DaisyOS.Shell.ViewModels"
             x:Class="DaisyOS.Shell.Views.Components.Launcher.LauncherView"
             x:DataType="vm:LauncherViewModel"
             ClipToBounds="True">

  <UserControl.Styles>
    <StyleInclude Source="avares://DaisyOS.Shell/Styles/SettingsInsetStyles.axaml" />
    <Style Selector="Border.LauncherBackdrop">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    </Style>
    <Style Selector="Border.LauncherBackdrop.SolidBackdrop">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseSolidBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="LauncherTileTemplate" DataType="vm:LauncherItemViewModel">
      <Button Classes="LauncherTile"
              Loaded="OnTileLoaded"
              Unloaded="OnTileUnloaded"
              DataContextChanged="OnTileDataContextChanged"
              Classes.SearchSelected="{Binding IsTopSearchResult}"
              Classes.KeyboardSelected="{Binding IsKeyboardSelected}"
              PointerPressed="OnTilePointerPressed"
              Click="OnAppItemClick"
              ToolTip.Tip="{Binding Description}">
        <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Panel Grid.Row="0" Width="68" Height="62" HorizontalAlignment="Center">
            <Panel Width="58" Height="58"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{Binding IconBitmap}" IsVisible="{Binding IsBitmapIconVisible}"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Width="58" Height="58" Stretch="Uniform" />
              <Border IsVisible="{Binding IsFallbackIconVisible}"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource StrokeDefaultBrush}"
                      BorderThickness="{DynamicResource BorderThicknessDefault}"
                      CornerRadius="{DynamicResource RoundedLG}"
                      Width="58" Height="58">
                <TextBlock Text="{Binding Initial}"
                           FontSize="{DynamicResource TypeSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ContentPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Panel>

            <Border IsVisible="{Binding IsTopSearchResult}"
                    Background="{DynamicResource ActionPrimaryBrush}"
                    CornerRadius="{DynamicResource RadiusPill}"
                    Padding="5,1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-1,-4,0"
                    IsHitTestVisible="False">
              <TextBlock Text="↵"
                         FontSize="{DynamicResource TypeSizeMicro}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ContentOnPrimaryActionBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Panel>

          <TextBlock Grid.Row="1"
                     Text="{Binding Name}"
                     FontSize="{DynamicResource TypeSizeCaption}"
                     LineHeight="{DynamicResource TypeLineCaption}"
                     FontWeight="Medium"
                     TextAlignment="Center"
                     Foreground="{DynamicResource ContentPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     MaxWidth="106"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,6,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="Transparent">
    <Grid x:Name="LauncherContentGrid">
      <Grid Margin="24">
      <controls:ShellFrameBorder x:Name="LauncherRootBorder"
              MaxWidth="{DynamicResource LauncherPanelMaxWidth}" MaxHeight="{DynamicResource LauncherPanelMaxHeight}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}" Padding="0"
              CornerRadius="{DynamicResource RoundedXXL}"
              BoxShadow="{DynamicResource ElevationShellGlassPanelShadow}"
              RenderTransformOrigin="50%,50%" ClipToBounds="False">
      <controls:ShellFrameBorder x:Name="LauncherInnerFrame" Background="Transparent"
              BorderBrush="{DynamicResource ShellSurfaceInnerBorderBrush}" BackgroundSizing="InnerBorderEdge"
              BorderThickness="{DynamicResource ShellFrameBorderThickness}" CornerRadius="{DynamicResource RoundedXXLInset}">
      <Border x:Name="LauncherPanelClip" Classes="LauncherBackdrop" ClipToBounds="True"
              CornerRadius="{DynamicResource RoundedXXLDoubleInset}">
      <Grid x:Name="LauncherInteractiveContent"
            Margin="22"
            Background="Transparent"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.Styles>
          <Style Selector="Button.LauncherUtility">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCircle}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationFast}" Easing="{StaticResource MotionEaseMove}" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Button.LauncherUtility:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
          </Style>
          <Style Selector="Button.LauncherUtility:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
          </Style>

          <!-- Command-search treatment on the top focal axis using standard system search height. -->
          <Style Selector="controls|SearchBar#LauncherSearchBar Border#SearchFrame">
            <Setter Property="Background" Value="{DynamicResource LauncherSearchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherSearchBorderBrush}" />
          </Style>

          <!-- Outer slot stays 136x128 (120+16 by 116+12) while giving icons and 2-line titles generous room. -->
          <Style Selector="Button.LauncherTile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="116" />
            <Setter Property="Padding" Value="6,8,6,6" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionDurationFast}" Easing="{StaticResource MotionEaseMove}" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Button.LauncherTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
          </Style>
          <Style Selector="Button.LauncherTile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
          </Style>
          <Style Selector="Button.LauncherTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
          </Style>
          <Style Selector="Button.LauncherTile.KeyboardSelected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LauncherTileSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherTileSelectedBorderBrush}" />
          </Style>
          <Style Selector="Button.LauncherTile.SearchSelected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LauncherTileSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherTileSelectedBorderBrush}" />
          </Style>
          <Style Selector="Button.LauncherTile.ContextMenuActive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LauncherTileHoverBrush}" />
          </Style>

          <Style Selector="Button.LauncherPageDotButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessNone}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
          </Style>
          <Style Selector="Button.LauncherPageDotButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
          </Style>
        </Grid.Styles>

        <Grid x:Name="LauncherStage" RowDefinitions="Auto,*,Auto" RenderTransformOrigin="50%,50%">
          <!-- Primary top focal axis: search and top results sit immediately adjacent. -->
          <Border Grid.Row="0" MaxWidth="{DynamicResource LauncherSearchMaxWidth}"
                  CornerRadius="{DynamicResource RadiusPill}"
                  BoxShadow="{DynamicResource ElevationShellGlassPanelShadow}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,16">
            <controls:SearchBar x:Name="LauncherSearchBar"
                                MaxWidth="{DynamicResource LauncherSearchMaxWidth}"
                                HorizontalAlignment="Stretch"
                                Height="{DynamicResource SearchHeightStandard}"
                                CornerRadius="{DynamicResource RadiusPill}"
                                Text="{Binding SearchText, Mode=TwoWay}"
                                PlaceholderText="{DynamicResource Loc_49C266BAAAA7}"
                                KeyDown="OnSearchKeyDown" />
          </Border>

          <!-- Application stage -->
          <Grid Grid.Row="1" RowDefinitions="Auto,*" ClipToBounds="True">
            <Grid Grid.Row="0" IsVisible="{Binding !ShowUnifiedSearch}" ColumnDefinitions="Auto,Auto,*" Width="{Binding PageGridWidth}" HorizontalAlignment="Center" Margin="0,0,0,16">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="{DynamicResource Loc_9CB965E5630E}" IsVisible="{Binding !HasSearchQuery}"
                           FontSize="{DynamicResource TypeSizeBodySmall}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ContentPrimaryBrush}"
                            VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Loc_E978B00DE465}" IsVisible="{Binding HasSearchQuery}"
                           FontSize="{DynamicResource TypeSizeBodySmall}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ContentPrimaryBrush}"
                            VerticalAlignment="Center" />
              </StackPanel>

              <Border Grid.Column="1"
                      Padding="0"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center">
                <Panel>
                  <TextBlock Text="{Binding AllAppsCountText}" IsVisible="{Binding !HasSearchQuery}"
                             FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium"
                             Foreground="{DynamicResource ContentPrimaryBrush}"
                              />
                  <TextBlock Text="{Binding SearchResultsCountText}" IsVisible="{Binding HasSearchQuery}"
                             FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Medium"
                             Foreground="{DynamicResource ContentPrimaryBrush}"
                              />
                </Panel>
              </Border>
            </Grid>

            <Grid Grid.Row="0" IsVisible="{Binding ShowUnifiedSearch}" ColumnDefinitions="*,Auto"
                  Margin="{DynamicResource LauncherResultsHeadingInset}">
              <TextBlock Text="{Binding ResultsHeading}" FontSize="{DynamicResource TypeSizeTitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource ContentPrimaryBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding SearchResultsCountText}" VerticalAlignment="Center"
                         FontSize="{DynamicResource TypeSizeCaption}" Foreground="{DynamicResource ContentSecondaryBrush}" />
            </Grid>

            <Grid x:Name="LauncherPageViewport" Grid.Row="1" RowDefinitions="Auto,*,Auto" SizeChanged="OnPageViewportSizeChanged" ClipToBounds="True">
              <Panel Grid.Row="1" IsVisible="{Binding ShowApplicationGrid}">
              <controls:LauncherItemsControl x:Name="OutgoingPageGrid" IsVisible="False" IsHitTestVisible="False"
                            Width="{Binding PageGridWidth}" Height="{Binding PageGridHeight}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ItemTemplate="{StaticResource LauncherTileTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:VirtualizingLauncherGrid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </controls:LauncherItemsControl>

              <controls:LauncherItemsControl x:Name="ApplicationGrid"
                            Width="{Binding PageGridWidth}" Height="{Binding PageGridHeight}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ItemTemplate="{StaticResource LauncherTileTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><controls:VirtualizingLauncherGrid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </controls:LauncherItemsControl>

              </Panel>
              <Border x:Name="SearchResultsSurface" Classes="SettingsGroupCard" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top"
                      IsVisible="{Binding ShowUnifiedSearch}">
              <ListBox x:Name="UniversalSearchList"
                       IsVisible="{Binding ShowUnifiedSearch}" ItemsSource="{Binding UniversalResults}"
                       SelectedItem="{Binding SelectedUniversalResult, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <ControlTemplate>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="{TemplateBinding CornerRadius}" HorizontalContentAlignment="Stretch" />
                      </ControlTemplate>
                    </Setter>
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="{DynamicResource SpaceInsetNone}" />
                    <Setter Property="Margin" Value="{DynamicResource SpaceInsetNone}" />
                    <Setter Property="CornerRadius" Value="{DynamicResource RoundedNone}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                  <Style Selector="ListBoxItem:selected, ListBoxItem:selected:pointerover, ListBoxItem:pressed">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="{DynamicResource LauncherResultHoverBrush}" />
                  </Style>
                  <Style Selector="Border.SearchResultRow.KeyboardSelected">
                    <Setter Property="Background" Value="{DynamicResource LauncherResultSelectedBrush}" />
                  </Style>
                  <Style Selector="Button.SearchResultLabel, Button.SearchResultAction">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
                  </Style>
                  <Style Selector="Button.SearchResultLabel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="Button.SearchResultAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource LauncherResultHoverBrush}" />
                  </Style>
                  <Style Selector="ComboBox.LauncherSettingSelector">
                    <Setter Property="MinWidth" Value="{DynamicResource LauncherSettingMinWidth}" />
                    <Setter Property="MaxWidth" Value="{DynamicResource LauncherSettingMaxWidth}" />
                    <Setter Property="Width" Value="{DynamicResource LauncherSettingPreferredWidth}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:UniversalSearchResultViewModel">
                    <Border Classes="SearchResultRow" Classes.KeyboardSelected="{Binding IsKeyboardSelected}"
                            MinHeight="{DynamicResource SettingsInsetRowMinHeight}"
                            Loaded="OnUniversalResultLoaded" DataContextChanged="OnUniversalResultDataContextChanged">
                      <Border.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Actions}">
                          <ContextMenu.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="vm:UniversalSearchActionViewModel">
                              <Setter Property="Header" Value="{Binding Label}" />
                              <Setter Property="Command" Value="{Binding Command}" />
                            </ControlTheme>
                          </ContextMenu.ItemContainerTheme>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid RowDefinitions="*,Auto">
                      <Border Classes="SettingsGroupRow">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource Space3}">
                        <Grid VerticalAlignment="Center" ToolTip.Tip="{Binding Subtitle}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource LauncherResultIconGap}">
                            <Panel Width="{DynamicResource LauncherResultIconSlot}" VerticalAlignment="Center">
                              <controls:DaisyIcon Icon="{Binding IconName}" Size="{DynamicResource LauncherResultIconSize}"
                                  IsVisible="{Binding Application.IsFallbackIconVisible, FallbackValue=True}"
                                  Foreground="{DynamicResource ContentPrimaryBrush}" HorizontalAlignment="Left" />
                              <Image Source="{Binding Application.IconBitmap}" Width="{DynamicResource LauncherResultIconSize}"
                                     Height="{DynamicResource LauncherResultIconSize}" Stretch="Uniform" HorizontalAlignment="Left"
                                     IsVisible="{Binding Application.IsBitmapIconVisible, FallbackValue=False}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TypeSizeBody}"
                                         Foreground="{DynamicResource ContentPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding ShowSubtitle}"
                                         Foreground="{DynamicResource ContentSecondaryBrush}" FontSize="{DynamicResource TypeSizeCaption}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <Button Classes="SearchResultLabel" Background="Transparent" Padding="0" Focusable="False"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding CanActivate}"
                                  AutomationProperties.Name="{Binding Title}"
                                  Click="OnUniversalResultClick" PointerPressed="OnUniversalResultPointerPressed" />
                        </Grid>
                        <Button Grid.Column="1" Classes="SearchResultAction" IsVisible="{Binding CanActivate}"
                                IsEnabled="{Binding CanActivate}" Padding="{DynamicResource LauncherResultActionInset}"
                                VerticalAlignment="Center" AutomationProperties.Name="{Binding PrimaryActionLabel}"
                                Click="OnUniversalResultClick" PointerPressed="OnUniversalResultPointerPressed">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                            <TextBlock Text="{Binding PrimaryActionLabel}" Foreground="{DynamicResource ContentPrimaryBrush}"
                                       FontSize="{DynamicResource TypeSizeBodyMedium}" />
                            <controls:DaisyIcon Icon="{Binding PrimaryActionIcon}" Size="{DynamicResource IconSizeStandard}"
                                                Foreground="{DynamicResource ContentPrimaryBrush}" />
                          </StackPanel>
                        </Button>
                        <Panel Grid.Column="1" IsVisible="{Binding HasSetting}">
                        <StackPanel DataContext="{Binding Setting}" x:DataType="vm:SettingSearchResultViewModel" Spacing="4" MaxWidth="{DynamicResource LauncherSettingMaxWidth}">
                        <ToggleSwitch IsVisible="{Binding IsBoolean}" x:DataType="vm:SettingSearchResultViewModel"
                                      IsChecked="{Binding Value, Mode=OneWay}" IsEnabled="{Binding CanUpdate}"
                                      AutomationProperties.Name="{Binding Title}" Click="OnSearchSettingClick" />
                        <ComboBox Classes="LauncherSettingSelector" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding Choice, Mode=TwoWay}" IsEnabled="{Binding CanUpdate}"
                                  AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Right" />

                        </StackPanel>
                        </Panel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError, FallbackValue=False}" TextWrapping="Wrap" Foreground="{DynamicResource ContentPrimaryBrush}" />
                          <TextBlock DataContext="{Binding Setting}" x:DataType="vm:SettingSearchResultViewModel"
                                     Text="{Binding Error}" IsVisible="{Binding HasError, FallbackValue=False}" TextWrapping="Wrap" Foreground="{DynamicResource ContentPrimaryBrush}" />
                        </StackPanel>
                      </Grid>
                      </Border>
                      <Border Grid.Row="1" Classes="SettingsGroupDivider" IsVisible="{Binding ShowDivider}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </Border>

              <StackPanel Grid.Row="1" Classes="EmptyState" IsVisible="{Binding ShowNoResults}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <controls:DaisyIcon Icon="magnifying-glass-minus"
                                    Size="{DynamicResource IconSizeHero}"
                                    Foreground="{DynamicResource ContentPrimaryBrush}"
                                    HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptySearchText}"
                           FontSize="{DynamicResource TypeSizeBodyMedium}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource ContentPrimaryBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>

          <!-- Utility bar: identity on the left, page indicators in the centre, power on the right. -->
          <Border Grid.Row="2" Padding="0,12,0,0" IsVisible="{Binding ShowApplicationGrid}">
            <Grid ColumnDefinitions="*,Auto,*" HorizontalAlignment="Stretch">
              <Border Grid.Column="0" HorizontalAlignment="Left" Padding="4,5"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusCircle}"
                          Background="{DynamicResource SurfaceRaisedSubtleBrush}"
                          >
                    <Grid>
                      <TextBlock Text="{Binding UserInitial}" IsVisible="{DynamicResource ProfilePictureMissing}"
                                 FontSize="{DynamicResource TypeSizeCaption}" FontWeight="Bold"
                                 Foreground="{DynamicResource ContentPrimaryBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse Fill="{DynamicResource ProfilePictureBrush}" />
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding UserName}" MaxWidth="140" TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource TypeSizeBodySmall}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource ContentPrimaryBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>

                <StackPanel x:Name="LauncherPageIndicators" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2" />

              <!-- Right: Power Menu Button. Its menu is detached to the native
                   system overlay so KWin can blur the launcher below it. -->
              <Button x:Name="PowerButton" Grid.Column="2" Classes="LauncherUtility"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="40" Height="40"
                      ToolTip.Tip="{DynamicResource Loc_E40690533ABD}"
                      Click="OnPowerButtonClicked">
                <controls:DaisyIcon Icon="power"
                                    Size="{DynamicResource IconSizeMedium}"
                                    Foreground="{DynamicResource ContentPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      </Border>
      </controls:ShellFrameBorder>
      </controls:ShellFrameBorder>
      </Grid>

      <controls:ShellFrameBorder x:Name="MenuBlurHost" IsVisible="False" Width="184"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
              CornerRadius="{DynamicResource RoundedLG}" Padding="0"
              BoxShadow="{DynamicResource ElevationFlyoutShadow}" ZIndex="100">
        <controls:ShellFrameBorder Background="{DynamicResource ShellFrameInnerHighlightBrush}"
                CornerRadius="{DynamicResource RoundedLGInset}" Padding="{DynamicResource ShellFrameSurfaceInset}">
          <Border Background="{DynamicResource ContextMenuBackgroundBrush}"
                  CornerRadius="{DynamicResource RoundedMD}" Padding="4">
            <StackPanel>
                <MenuItem Header="{DynamicResource Loc_DB44B8DB4F05}" Click="OnLockClicked">
                  <MenuItem.Icon>
                    <controls:DaisyIcon Icon="lock" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Loc_D466BCF52EB6}" Click="OnSuspendClicked">
                  <MenuItem.Icon>
                    <controls:DaisyIcon Icon="moon" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Loc_49616145514E}" Click="OnLogOutClicked">
                  <MenuItem.Icon>
                    <controls:DaisyIcon Icon="sign-out" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Loc_6B983A81E5E8}" Click="OnRestartClicked">
                  <MenuItem.Icon>
                    <controls:DaisyIcon Icon="arrows-clockwise" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Loc_A4193461E8AC}" Click="OnShutdownClicked">
                  <MenuItem.Icon>
                    <controls:DaisyIcon Icon="power" Classes="MenuIcon"/>
                  </MenuItem.Icon>
                </MenuItem>
            </StackPanel>
          </Border>
        </controls:ShellFrameBorder>
      </controls:ShellFrameBorder>

      <controls:ShellFrameBorder x:Name="LauncherAppContextMenuHost" IsVisible="False" Width="204"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" BorderBrush="{DynamicResource ShellFrameOuterEdgeBrush}" BorderThickness="{DynamicResource ShellFrameBorderThickness}"
              CornerRadius="{DynamicResource RoundedLG}" Padding="0"
              BoxShadow="{DynamicResource ElevationFlyoutShadow}" ZIndex="101">
        <controls:ShellFrameBorder Background="{DynamicResource ShellFrameInnerHighlightBrush}" CornerRadius="{DynamicResource RoundedLGInset}" Padding="{DynamicResource ShellFrameSurfaceInset}">
          <Border Background="{DynamicResource ContextMenuBackgroundBrush}" CornerRadius="{DynamicResource RoundedMD}" Padding="4">
            <StackPanel>
              <MenuItem Header="{DynamicResource Loc_ED077F3D8125}" Click="OnContextOpenClicked"><MenuItem.Icon><controls:DaisyIcon Icon="arrow-square-out" Classes="MenuIcon" /></MenuItem.Icon></MenuItem>
              <Separator />
              <MenuItem Header="{DynamicResource Loc_79614996AD63}" Click="OnAddToDesktopClicked"><MenuItem.Icon><controls:DaisyIcon Icon="desktop" Classes="MenuIcon" /></MenuItem.Icon></MenuItem>
              <MenuItem Header="{DynamicResource Loc_83F1B0FAC0CE}" Click="OnPinToTaskbarClicked"><MenuItem.Icon><controls:DaisyIcon Icon="push-pin" Classes="MenuIcon" /></MenuItem.Icon></MenuItem>
              <Separator />
              <MenuItem x:Name="LauncherUninstallMenuItem" Header="{DynamicResource Loc_FE199528850A}" Classes="Danger" Click="OnLauncherUninstallClicked"><MenuItem.Icon><controls:DaisyIcon Icon="trash" Classes="MenuIcon" /></MenuItem.Icon></MenuItem>
            </StackPanel>
          </Border>
        </controls:ShellFrameBorder>
      </controls:ShellFrameBorder>
    </Grid>
  </Grid>
</UserControl>
