<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:typography="clr-namespace:DaisyOS.Shell.Services.Theming">
    <!-- Universal Sidebar Item Style (SettingsNavItem) -->
    <Style Selector="Button.SettingsNavItem">
      <Setter Property="Height" Value="{DynamicResource InputHeightStandard}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RoundedSM}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Smooth hover/active fade instead of an instant background snap. -->
    <Style Selector="Button.SettingsNavItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationHover}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SettingsNavItem TextBlock, Button.SettingsNavItem.Active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ContentPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeSizeBodySmall}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="typography:SidebarLabelAlignment.Enabled" Value="True" />
    </Style>
    <Style Selector="Button.SettingsNavItem TextBlock.SecondaryText">
      <Setter Property="Foreground" Value="{DynamicResource ContentSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Regular" />
    </Style>
    <Style Selector="Button.SettingsNavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.SettingsNavItem:not(.Active):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector="Button.SettingsNavItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

</Styles>
