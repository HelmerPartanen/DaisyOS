<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ShellOutput>$(MSBuildThisFileDirectory)../../src/DaisyOS.Shell/bin/Debug/net10.0</ShellOutput>
  </PropertyGroup>
  <!-- Use the just-built pinned shell, without rebuilding the Avalonia fork. -->
  <ItemGroup>
    <Reference Include="$(ShellOutput)/*.dll" />
  </ItemGroup>
</Project>
