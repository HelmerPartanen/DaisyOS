#!/usr/bin/env bash
set -euo pipefail
# User services may retain a dead display after the native compositor restarts.
# Recover only from this session's recorded display, never an arbitrary socket.
if [[ -n "${XDG_RUNTIME_DIR:-}" && ( -n "${WAYLAND_DISPLAY:-}" || -r "$XDG_RUNTIME_DIR/daisyos-native-development/wayland-display" ) ]]; then
  if resolved_display="$(python3 - <<'DISPLAY_PY'
import os, pathlib, socket, sys
runtime = pathlib.Path(os.environ['XDG_RUNTIME_DIR'])
candidates = [os.environ.get('WAYLAND_DISPLAY', '')]
try:
    candidates.append((runtime / 'daisyos-native-development/wayland-display').read_text().strip())
except OSError:
    pass
for display in dict.fromkeys(candidates):
    if not display:
        continue
    path = pathlib.Path(display)
    if not path.is_absolute():
        path = runtime / path
    try:
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(1)
            connection.connect(str(path))
        print(display)
        sys.exit(0)
    except OSError:
        pass
sys.exit(1)
DISPLAY_PY
)"; then
    export WAYLAND_DISPLAY="$resolved_display"
  else
    echo 'DaisyOS portal is waiting for a reachable Wayland display.' >&2
    exit 1
  fi
fi
# Installed systems use the published shell; development sessions use their selected checkout.
if [[ -f /etc/daisyos/daisyos-native-development.conf ]]; then
  # shellcheck source=/dev/null
  source /etc/daisyos/daisyos-native-development.conf
fi
user_config="${XDG_CONFIG_HOME:-$HOME/.config}/DaisyOS/desktop-services.env"
if [[ -f "$user_config" ]]; then
  # shellcheck source=/dev/null
  source "$user_config"
fi
if [[ -n "${DAISYOS_DESKTOP_SERVICES_BINARY:-}" ]]; then
  desktop_binary="$DAISYOS_DESKTOP_SERVICES_BINARY"
elif [[ -n "${DAISYOS_NATIVE_DEVELOPMENT_ROOT:-}" ]]; then
  shell_configuration="${DAISYOS_SHELL_CONFIGURATION:-}"
  configuration_record="${XDG_RUNTIME_DIR:-/nonexistent}/daisyos-native-development/shell.configuration"
  if [[ -z "$shell_configuration" && -r "$configuration_record" ]]; then
    read -r shell_configuration < "$configuration_record"
  fi
  # Older active development supervisors have no record and still run Debug.
  shell_configuration="${shell_configuration:-Debug}"
  desktop_binary="${DAISYOS_NATIVE_DEVELOPMENT_SHELL_BINARY:-$DAISYOS_NATIVE_DEVELOPMENT_ROOT/src/DaisyOS.Shell/bin/$shell_configuration/net10.0/DaisyOS.Shell}"
else
  desktop_binary=/opt/DaisyOS/shell/DaisyOS.Shell
  if [[ ! -x "$desktop_binary" && -x /usr/lib/daisyos/DaisyOS.Shell ]]; then desktop_binary=/usr/lib/daisyos/DaisyOS.Shell; fi
fi
[[ -x "$desktop_binary" ]] || { echo 'DaisyOS desktop services are not built.' >&2; exit 1; }
exec "$desktop_binary" --desktop-services --authentication-agent
