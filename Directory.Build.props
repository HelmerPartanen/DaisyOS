<Project>
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <DaisyOSVersionChannel Condition="'$(DaisyOSVersionChannel)' == ''">nightly</DaisyOSVersionChannel>
    <DaisyOSBuildDate Condition="'$(DaisyOSBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</DaisyOSBuildDate>
    <DaisyOSSourceRevision Condition="'$(DaisyOSSourceRevision)' == ''">local</DaisyOSSourceRevision>
    <DaisyOSVersionLabel Condition="'$(DaisyOSVersionChannel)' == 'stable'">$(VersionPrefix)+$(DaisyOSBuildDate).$(DaisyOSSourceRevision)</DaisyOSVersionLabel>
    <DaisyOSVersionLabel Condition="'$(DaisyOSVersionChannel)' != 'stable'">$(VersionPrefix)-$(DaisyOSVersionChannel).$(DaisyOSBuildDate)+$(DaisyOSSourceRevision)</DaisyOSVersionLabel>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(DaisyOSVersionLabel)</InformationalVersion>
  </PropertyGroup>
  <!--
    Desktop processes favor a small resident footprint over peak allocation
    throughput. Workstation GC with ConserveMemory compacts more readily
    instead of growing the heap, and RetainVM=false returns freed segments to
    the OS. Applies to every DaisyOS executable (shell, Files, Notes, ...).
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
