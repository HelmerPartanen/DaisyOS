#!/usr/bin/env python3
"""Read-only, privacy-conscious DaisyOS gaming environment report."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def command(args: list[str], timeout: float = 8) -> str:
    if not shutil.which(args[0]):
        return "Unavailable"
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "Failed or timed out"
    if result.returncode:
        return "Unavailable"
    return result.stdout.strip() or "No output"


def read(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8").strip() or "Unknown"
    except (OSError, UnicodeError):
        return "Unknown"


def package_versions(names: list[str]) -> dict[str, str]:
    result = {}
    has_pacman = shutil.which("pacman") is not None
    for name in names:
        output = command(["pacman", "-Q", name], timeout=3)
        if output != "Unavailable":
            result[name] = output
        else:
            result[name] = "Not installed" if has_pacman else "Unknown (pacman unavailable)"
    return result


def cpu_summary() -> str:
    output = command(["lscpu", "-J"], timeout=5)
    if output in {"Unavailable", "Failed or timed out", "No output"}:
        return output
    try:
        rows = json.loads(output).get("lscpu", [])
        wanted = {"Architecture", "CPU(s)", "Vendor ID", "Model name", "Thread(s) per core"}
        values = {row.get("field", "").rstrip(":"): row.get("data", "Unknown") for row in rows}
        return "; ".join(f"{key}: {values.get(key, 'Unknown')}" for key in sorted(wanted))
    except (json.JSONDecodeError, AttributeError, TypeError):
        return "lscpu returned an unrecognized format"


def cpu_power_capabilities() -> dict:
    """Read the kernel's advertised CPU policy capabilities without changing them."""
    policies = []
    for directory in sorted(Path("/sys/devices/system/cpu/cpufreq").glob("policy[0-9]*")):
        values = {}
        for filename, label in (
            ("affected_cpus", "cpus"),
            ("scaling_driver", "driver"),
            ("scaling_governor", "governor"),
            ("scaling_available_governors", "available_governors"),
            ("energy_performance_preference", "epp"),
            ("energy_performance_available_preferences", "available_epp"),
            ("scaling_min_freq", "minimum_khz"),
            ("scaling_max_freq", "maximum_khz"),
            ("cpuinfo_min_freq", "hardware_minimum_khz"),
            ("cpuinfo_max_freq", "hardware_maximum_khz"),
        ):
            path = directory / filename
            if path.exists():
                value = read(str(path))
                if value != "Unknown":
                    values[label] = value
        policies.append({"policy": directory.name, **values})

    core_types: dict[str, int] = {}
    for path in Path("/sys/devices/system/cpu").glob("cpu[0-9]*/topology/core_type"):
        value = read(str(path))
        if value != "Unknown":
            core_types[value] = core_types.get(value, 0) + 1

    amd_pstate = {}
    for name in ("status", "cppc_dynamic_boost"):
        path = Path("/sys/devices/system/cpu/amd_pstate") / name
        if path.exists():
            value = read(str(path))
            if value != "Unknown":
                amd_pstate[name] = value

    intel_pstate = {}
    for name in ("status", "no_turbo"):
        path = Path("/sys/devices/system/cpu/intel_pstate") / name
        if path.exists():
            value = read(str(path))
            if value != "Unknown":
                intel_pstate[name] = value

    return {
        "policy_count": len(policies),
        "policies": policies,
        "heterogeneous_core_type_counts": core_types,
        "amd_pstate": amd_pstate,
        "intel_pstate": intel_pstate,
    }


def power_profile_capabilities() -> dict:
    current = command(["powerprofilesctl", "get"], timeout=3)
    listing = command(["powerprofilesctl", "list"], timeout=3)
    # Keep only profile identifiers. powerprofilesctl presentation details vary
    # by version; the active profile is always queried independently above.
    available = sorted(set(re.findall(r"(?m)^\s*\*?\s*(power-saver|balanced|performance):?\s*$", listing)))
    return {
        "daemon": "Installed" if shutil.which("powerprofilesctl") else "Not installed",
        "active": current,
        "available": available if listing not in {"Unavailable", "Failed or timed out", "No output"} else [],
        "listing_status": "Available" if listing not in {"Unavailable", "Failed or timed out", "No output"} else listing,
    }


def gpu_summary() -> str:
    output = command(["lspci", "-nnk"], timeout=5)
    if output in {"Unavailable", "Failed or timed out", "No output"}:
        return output
    rows: list[str] = []
    keep = False
    for line in output.splitlines():
        if re.search(r"(VGA compatible controller|3D controller|Display controller)", line, re.I):
            keep = True
            rows.append(line.strip())
        elif keep and line.lstrip().startswith(("Kernel driver in use:", "Kernel modules:")):
            rows.append(line.strip())
        elif line and not line[0].isspace():
            keep = False
    return "\n".join(rows) or "No display controller reported"


def vulkan32_probe() -> str:
    configured = os.environ.get("DAISYOS_VULKAN32_PROBE")
    candidates = [Path(configured)] if configured else []
    candidates.extend([
        Path("/usr/lib/daisyos/daisyos-vulkan32-probe"),
        Path(shutil.which("daisyos-vulkan32-probe") or "/nonexistent"),
    ])
    executable = next((path for path in candidates if path.is_file() and os.access(path, os.X_OK)), None)
    if executable is None:
        return "Not run (optional 32-bit probe is not installed)"
    try:
        result = subprocess.run([str(executable)], capture_output=True, text=True, timeout=10, check=False)
    except subprocess.TimeoutExpired:
        return "Failed (probe timed out)"
    except OSError:
        return "Failed (probe could not start)"
    output = result.stdout.strip().replace("\n", "; ")
    if result.returncode == 0 and re.search(r"physical_devices=[1-9][0-9]*", output):
        return f"Passed: {output}"
    detail = output or result.stderr.strip().replace("\n", "; ") or "no details"
    return f"Failed (exit {result.returncode}): {detail}"


def ntsync_status() -> str:
    device = Path("/dev/ntsync")
    if device.exists():
        if os.access(device, os.R_OK | os.W_OK):
            return "Kernel device present and accessible; Proton/runtime use not verified"
        return "Kernel device present but not accessible to this user"
    module = Path("/sys/module/ntsync")
    if module.exists():
        return "Kernel module loaded; device node unavailable"
    modules = command(["modinfo", "-F", "filename", "ntsync"], timeout=3)
    if modules not in {"Unavailable", "Failed or timed out", "No output"}:
        return "Kernel module available but not loaded"
    return "Not detected in the running kernel"


def proton_tools() -> list[str]:
    return sorted((path.name for path in proton_tool_directories()), key=str.casefold)


def proton_tool_directories() -> list[Path]:
    home = Path.home()
    steam_roots = [
        home / ".local/share/Steam",
        home / ".steam/steam",
        home / ".steam/root",
        home / ".var/app/com.valvesoftware.Steam/data/Steam",
    ]
    libraries = set(steam_roots)
    library_path = re.compile(r'"path"\s+"([^"]+)"')
    for root in steam_roots:
        manifest = root / "steamapps/libraryfolders.vdf"
        try:
            text = manifest.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for match in library_path.finditer(text):
            value = match.group(1)
            if value.startswith("/"):
                libraries.add(Path(value))
    tools: dict[str, Path] = {}
    for root in libraries:
        common = root / "steamapps/common"
        if common.is_dir():
            tools.update({path.name: path for path in common.glob("Proton*") if path.is_dir()})
    for root in steam_roots:
        custom = root / "compatibilitytools.d"
        if custom.is_dir():
            for path in custom.iterdir():
                if path.is_dir() and (path / "compatibilitytool.vdf").is_file():
                    tools[path.name] = path
    return sorted(tools.values(), key=lambda path: path.name.casefold())


def proton_component_inventory() -> list[dict[str, str]]:
    dxvk_markers = ["files/lib/wine/dxvk", "files/lib64/wine/dxvk"]
    vkd3d_markers = ["files/lib/wine/vkd3d-proton", "files/lib64/wine/vkd3d-proton"]
    inventory = []
    for tool in proton_tool_directories():
        dxvk = any((tool / marker).is_dir() for marker in dxvk_markers)
        vkd3d = any((tool / marker).is_dir() for marker in vkd3d_markers)
        inventory.append({
            "tool": tool.name,
            "DXVK payload": "detected" if dxvk else "not detected in standard path",
            "VKD3D-Proton payload": "detected" if vkd3d else "not detected in standard path",
        })
    return inventory


def collect() -> dict:
    vulkan = command(["vulkaninfo", "--summary"], timeout=15)
    if vulkan not in {"Unavailable", "Failed or timed out", "No output"}:
        # Keep only device/driver identity lines; the full output can contain
        # paths and implementation details irrelevant to a shareable report.
        vulkan = "\n".join(
            line.strip() for line in vulkan.splitlines()
            if re.search(r"(deviceName|driverName|driverInfo|apiVersion|deviceType|GPU[0-9])", line, re.I)
        ) or "vulkaninfo succeeded; device identity fields were not recognized"

    icd_dirs = [Path("/usr/share/vulkan/icd.d"), Path("/usr/lib32/vulkan/icd.d")]
    manifests = {}
    for directory in icd_dirs:
        manifests[str(directory)] = sorted(path.name for path in directory.glob("*.json")) if directory.is_dir() else []

    env = os.environ
    compositor = env.get("XDG_CURRENT_DESKTOP") or env.get("XDG_SESSION_DESKTOP") or "Unknown"
    session_type = env.get("XDG_SESSION_TYPE", "Unknown")
    power_profiles = power_profile_capabilities()
    thermal = command(["systemd-detect-virt"], timeout=3)
    vulkan32 = vulkan32_probe()
    vulkan_software = bool(re.search(r"(llvmpipe|lavapipe|software rasterizer|deviceType\s*[:=]\s*PHYSICAL_DEVICE_TYPE_CPU)", vulkan, re.I))
    glx = command(["glxinfo", "-B"], timeout=8)
    glx_renderer = next((line.strip() for line in glx.splitlines() if re.search(r"OpenGL renderer string:", line, re.I)), "Unavailable")
    software_renderer = vulkan_software or bool(re.search(r"(llvmpipe|softpipe|lavapipe)", glx_renderer, re.I))
    warnings = [
        "The 64-bit field runs vulkaninfo when available; it does not validate a game runtime.",
        "The 32-bit probe is only run when the optional i686 Vulkan probe is installed.",
        "Thermal throttling, VRR, display refresh, Proton version, and game launch paths require follow-up validation.",
    ]
    if software_renderer:
        warnings.insert(0, "A software Vulkan/OpenGL renderer was detected; confirm this is expected for the active GPU.")
    return {
        "kernel": command(["uname", "-r"], timeout=3),
        "architecture": command(["uname", "-m"], timeout=3),
        "cpu": cpu_summary(),
        "cpu_frequency_driver": read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_driver"),
        "cpu_power_capabilities": cpu_power_capabilities(),
        "cpu_scheduler": read("/sys/block/nvme0n1/queue/scheduler"),
        "gpu_and_kernel_driver": gpu_summary(),
        "vulkan_64_bit_probe": vulkan,
        "vulkan_32_bit_loader": "Present" if Path("/usr/lib32/libvulkan.so.1").exists() else "Not found",
        "vulkan_32_bit_probe": vulkan32,
        "installed_proton_tools": proton_tools(),
        "proton_component_inventory": proton_component_inventory(),
        "umu_runner": "Installed" if shutil.which("umu-run") else "Not installed",
        "ntsync_kernel_status": ntsync_status(),
        "opengl_renderer": glx_renderer,
        "software_renderer_detected": software_renderer,
        "vulkan_icd_manifests": manifests,
        "packages": package_versions([
            "mesa", "lib32-mesa", "vulkan-icd-loader", "lib32-vulkan-icd-loader",
            "nvidia-open", "nvidia-utils", "lib32-nvidia-utils", "steam", "umu-launcher", "gamemode",
            "gamescope", "goverlay", "mangohud", "wine",
        ]),
        "steam_version": command(["steam", "--version"], timeout=5),
        "gamemode_version": command(["gamemoded", "--version"], timeout=5),
        "session_type": session_type,
        "desktop_session": compositor,
        "compositor_processes": command(["pgrep", "-a", "-f", "kwin_wayland|kwin_x11|Xorg|sway"], timeout=3),
        "power_profile": power_profiles["active"],
        "power_profile_capabilities": power_profiles,
        "power_source": power_source(),
        "thermal_throttling": "Not measured by this initial report",
        "virtualization": thermal,
        "warnings": warnings,
    }


def power_source() -> str:
    for supply in Path("/sys/class/power_supply").glob("*"):
        if read(str(supply / "type")) != "Battery":
            continue
        status = read(str(supply / "status"))
        return status
    return "AC/desktop or unavailable"


def format_report(report: dict) -> str:
    def one_line(value: object) -> str:
        return str(value).replace("\n", "; ")

    lines = ["DaisyOS Gaming Diagnostics", "=" * 26]
    labels = [
        ("kernel", "Kernel"), ("architecture", "Architecture"), ("cpu", "CPU (lscpu JSON)"),
        ("cpu_frequency_driver", "CPU frequency driver"), ("cpu_power_capabilities", "CPU policy capabilities"),
        ("cpu_scheduler", "Block scheduler (NVMe 0)"),
        ("gpu_and_kernel_driver", "GPU and kernel driver"), ("vulkan_64_bit_probe", "Vulkan 64-bit"),
        ("vulkan_32_bit_loader", "Vulkan 32-bit loader"), ("vulkan_icd_manifests", "Vulkan ICD manifests"),
        ("vulkan_32_bit_probe", "Vulkan 32-bit device probe"),
        ("installed_proton_tools", "Installed Proton tools (detected Steam libraries)"),
        ("proton_component_inventory", "Proton DXVK/VKD3D payload markers"),
        ("umu_runner", "UMU runner"), ("ntsync_kernel_status", "NTSYNC kernel status"),
        ("opengl_renderer", "OpenGL renderer"), ("software_renderer_detected", "Software renderer detected"),
        ("steam_version", "Steam"), ("gamemode_version", "GameMode"), ("session_type", "Session type"),
        ("desktop_session", "Desktop session"), ("compositor_processes", "Compositor processes"),
        ("power_profile", "Power profile"), ("power_profile_capabilities", "Power profile capabilities"),
        ("power_source", "Power source"),
        ("thermal_throttling", "Thermal throttling"), ("packages", "Package versions"),
    ]
    for key, label in labels:
        value = report[key]
        lines.append(f"{label}: {json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else one_line(value)}")
    lines.append("Known warnings:")
    lines.extend(f"- {warning}" for warning in report["warnings"])
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = parser.parse_args()
    report = collect()
    print(json.dumps(report, indent=2, ensure_ascii=False) if args.json else format_report(report))
    return 0


if __name__ == "__main__":
    sys.exit(main())
