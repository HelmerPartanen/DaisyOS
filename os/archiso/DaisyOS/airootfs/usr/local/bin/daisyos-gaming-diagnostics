#!/usr/bin/env python3
"""Read-only, privacy-conscious DaisyOS gaming environment report."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def command(args: list[str], timeout: float = 8) -> str:
    if not shutil.which(args[0]):
        return "Unavailable"
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "Failed or timed out"
    if result.returncode:
        return "Unavailable"
    return result.stdout.strip() or "No output"


def read(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8").strip() or "Unknown"
    except (OSError, UnicodeError):
        return "Unknown"


def package_versions(names: list[str]) -> dict[str, str]:
    result = {}
    has_pacman = shutil.which("pacman") is not None
    for name in names:
        output = command(["pacman", "-Q", name], timeout=3)
        if output != "Unavailable":
            result[name] = output
        else:
            result[name] = "Not installed" if has_pacman else "Unknown (pacman unavailable)"
    return result


def cpu_summary() -> str:
    output = command(["lscpu", "-J"], timeout=5)
    if output in {"Unavailable", "Failed or timed out", "No output"}:
        return output
    try:
        rows = json.loads(output).get("lscpu", [])
        wanted = {"Architecture", "CPU(s)", "Model name", "Thread(s) per core"}
        values = {row.get("field", "").rstrip(":"): row.get("data", "Unknown") for row in rows}
        return "; ".join(f"{key}: {values.get(key, 'Unknown')}" for key in sorted(wanted))
    except (json.JSONDecodeError, AttributeError, TypeError):
        return "lscpu returned an unrecognized format"


def gpu_summary() -> str:
    output = command(["lspci", "-nnk"], timeout=5)
    if output in {"Unavailable", "Failed or timed out", "No output"}:
        return output
    rows: list[str] = []
    keep = False
    for line in output.splitlines():
        if re.search(r"(VGA compatible controller|3D controller|Display controller)", line, re.I):
            keep = True
            rows.append(line.strip())
        elif keep and line.lstrip().startswith(("Kernel driver in use:", "Kernel modules:")):
            rows.append(line.strip())
        elif line and not line[0].isspace():
            keep = False
    return "\n".join(rows) or "No display controller reported"


def collect() -> dict:
    vulkan = command(["vulkaninfo", "--summary"], timeout=15)
    if vulkan not in {"Unavailable", "Failed or timed out", "No output"}:
        # Keep only device/driver identity lines; the full output can contain
        # paths and implementation details irrelevant to a shareable report.
        vulkan = "\n".join(
            line.strip() for line in vulkan.splitlines()
            if re.search(r"(deviceName|driverName|driverInfo|apiVersion|deviceType|GPU[0-9])", line, re.I)
        ) or "vulkaninfo succeeded; device identity fields were not recognized"

    icd_dirs = [Path("/usr/share/vulkan/icd.d"), Path("/usr/lib32/vulkan/icd.d")]
    manifests = {}
    for directory in icd_dirs:
        manifests[str(directory)] = sorted(path.name for path in directory.glob("*.json")) if directory.is_dir() else []

    env = os.environ
    compositor = env.get("XDG_CURRENT_DESKTOP") or env.get("XDG_SESSION_DESKTOP") or "Unknown"
    session_type = env.get("XDG_SESSION_TYPE", "Unknown")
    power_profile = command(["powerprofilesctl", "get"], timeout=3)
    thermal = command(["systemd-detect-virt"], timeout=3)
    vulkan_software = bool(re.search(r"(llvmpipe|lavapipe|software rasterizer|deviceType\s*[:=]\s*PHYSICAL_DEVICE_TYPE_CPU)", vulkan, re.I))
    glx = command(["glxinfo", "-B"], timeout=8)
    glx_renderer = next((line.strip() for line in glx.splitlines() if re.search(r"OpenGL renderer string:", line, re.I)), "Unavailable")
    software_renderer = vulkan_software or bool(re.search(r"(llvmpipe|softpipe|lavapipe)", glx_renderer, re.I))
    warnings = [
        "The 64-bit field runs vulkaninfo when available; it does not validate a game runtime.",
        "The 32-bit field reports loader presence only. Actual 32-bit ICD enumeration is not yet implemented.",
        "Thermal throttling, VRR, display refresh, Proton version, and game launch paths require follow-up validation.",
    ]
    if software_renderer:
        warnings.insert(0, "A software Vulkan/OpenGL renderer was detected; confirm this is expected for the active GPU.")
    return {
        "kernel": command(["uname", "-r"], timeout=3),
        "architecture": command(["uname", "-m"], timeout=3),
        "cpu": cpu_summary(),
        "cpu_frequency_driver": read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_driver"),
        "cpu_scheduler": read("/sys/block/nvme0n1/queue/scheduler"),
        "gpu_and_kernel_driver": gpu_summary(),
        "vulkan_64_bit_probe": vulkan,
        "vulkan_32_bit_loader": "Present" if Path("/usr/lib32/libvulkan.so.1").exists() else "Not found",
        "opengl_renderer": glx_renderer,
        "software_renderer_detected": software_renderer,
        "vulkan_icd_manifests": manifests,
        "packages": package_versions([
            "mesa", "lib32-mesa", "vulkan-icd-loader", "lib32-vulkan-icd-loader",
            "nvidia-open", "nvidia-utils", "lib32-nvidia-utils", "steam", "gamemode",
            "gamescope", "mangohud", "wine",
        ]),
        "steam_version": command(["steam", "--version"], timeout=5),
        "gamemode_version": command(["gamemoded", "--version"], timeout=5),
        "session_type": session_type,
        "desktop_session": compositor,
        "compositor_processes": command(["pgrep", "-a", "-f", "kwin_wayland|kwin_x11|Xorg|sway"], timeout=3),
        "power_profile": power_profile,
        "power_source": power_source(),
        "thermal_throttling": "Not measured by this initial report",
        "virtualization": thermal,
        "warnings": warnings,
    }


def power_source() -> str:
    for supply in Path("/sys/class/power_supply").glob("*"):
        if read(str(supply / "type")) != "Battery":
            continue
        status = read(str(supply / "status"))
        return status
    return "AC/desktop or unavailable"


def format_report(report: dict) -> str:
    def one_line(value: object) -> str:
        return str(value).replace("\n", "; ")

    lines = ["DaisyOS Gaming Diagnostics", "=" * 26]
    labels = [
        ("kernel", "Kernel"), ("architecture", "Architecture"), ("cpu", "CPU (lscpu JSON)"),
        ("cpu_frequency_driver", "CPU frequency driver"), ("cpu_scheduler", "Block scheduler (NVMe 0)"),
        ("gpu_and_kernel_driver", "GPU and kernel driver"), ("vulkan_64_bit_probe", "Vulkan 64-bit"),
        ("vulkan_32_bit_loader", "Vulkan 32-bit loader"), ("vulkan_icd_manifests", "Vulkan ICD manifests"),
        ("opengl_renderer", "OpenGL renderer"), ("software_renderer_detected", "Software renderer detected"),
        ("steam_version", "Steam"), ("gamemode_version", "GameMode"), ("session_type", "Session type"),
        ("desktop_session", "Desktop session"), ("compositor_processes", "Compositor processes"),
        ("power_profile", "Power profile"), ("power_source", "Power source"),
        ("thermal_throttling", "Thermal throttling"), ("packages", "Package versions"),
    ]
    for key, label in labels:
        value = report[key]
        lines.append(f"{label}: {json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else one_line(value)}")
    lines.append("Known warnings:")
    lines.extend(f"- {warning}" for warning in report["warnings"])
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = parser.parse_args()
    report = collect()
    print(json.dumps(report, indent=2, ensure_ascii=False) if args.json else format_report(report))
    return 0


if __name__ == "__main__":
    sys.exit(main())
