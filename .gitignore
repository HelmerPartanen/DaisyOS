packaging/
# The KWin bridge is source code installed into the user's session, not a
# generated packaging artifact.
!packaging/
packaging/*
!packaging/kwin/
!packaging/kwin/daisyos-window-bridge/
!packaging/kwin/daisyos-window-bridge/metadata.json
!packaging/kwin/daisyos-window-bridge/contents/
!packaging/kwin/daisyos-window-bridge/contents/code/
!packaging/kwin/daisyos-window-bridge/contents/code/main.js
!packaging/wayland-sessions/
packaging/wayland-sessions/*
!packaging/wayland-sessions/daisyos-development.desktop
# Portal configuration is source, not generated package output.
!packaging/xdg-desktop-portal/
packaging/xdg-desktop-portal/*
!packaging/xdg-desktop-portal/daisyos-portals.conf
!packaging/xdg-desktop-portal/kde-backend.conf

