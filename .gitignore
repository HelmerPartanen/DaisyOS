# Build results
[Bb]in/
[Oo]bj/
target/
DaisyIconBundle/
[Oo]ut/
artifacts/
publish/
work/
out/
.codex/
[Tt]est[Rr]esults/
*.trx

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Native CMake & C++ build outputs
src/native/*/build/
services/*/build/
**/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.ninja_deps
*.ninja_log

packaging/
# The KWin bridge is source code installed into the user's session, not a
# generated packaging artifact.
!packaging/
packaging/*
!packaging/kwin/
!packaging/kwin/daisyos-window-bridge/
!packaging/kwin/daisyos-window-bridge/metadata.json
!packaging/kwin/daisyos-window-bridge/contents/
!packaging/kwin/daisyos-window-bridge/contents/code/
!packaging/kwin/daisyos-window-bridge/contents/code/main.js
!packaging/wayland-sessions/
packaging/wayland-sessions/*
!packaging/wayland-sessions/daisyos-development.desktop
# Portal configuration is source, not generated package output.
!packaging/xdg-desktop-portal/
packaging/xdg-desktop-portal/*
!packaging/xdg-desktop-portal/daisyos-portals.conf
!packaging/xdg-desktop-portal/kde-backend.conf

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# IDEs & Editors
.idea/
.vscode/
.vs/
*.swp
*.swo
*.*~
.cache/
.clangd/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Dumps
*.log
core
core.*
*.dmp

# Release definitions and gaming policy are source, not generated packages.
!packaging/arch/
packaging/arch/*
!packaging/arch/PKGBUILD
!packaging/arch/daisyos-repo.conf
!packaging/arch/daisyos-shell
!packaging/arch/daisyos-shell.desktop
!packaging/arch/daisyos-shell.install
!packaging/arch/daisyos-shell.service
!packaging/arch/defaults/
packaging/arch/defaults/*
!packaging/arch/defaults/settings.json
!packaging/gaming/
packaging/gaming/*
!packaging/gaming/60-daisyos-gamemode.rules
!packaging/wayland-sessions/daisyos-native-development.desktop
# ISO launchers are source scripts; published binaries remain under ignored opt payloads.
!os/archiso/DaisyOS/airootfs/usr/local/bin/

!packaging/xdg-desktop-portal/
!packaging/xdg-desktop-portal/*

# Licensed system typography defaults are source assets.
!packaging/fonts/
!packaging/fonts/60-daisyos-fonts.conf
!packaging/fonts/90-daisyos.gschema.override

!packaging/librepods/
!packaging/librepods/**

# Local OAuth registration is provisioned by the distributor, never committed.
**/mail-providers.json
/mail-providers.local.json
!packaging/mail/
!packaging/mail/mail-providers.example.json

# Source-controlled application ownership policy and authentication action.
!packaging/applications/
!packaging/applications/**
!packaging/polkit/
!packaging/polkit/**
