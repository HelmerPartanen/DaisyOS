pkgname=daisyos-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="DaisyOS custom C#/.NET Avalonia shell"
arch=('x86_64')
url="https://github.com/helmeri/SnapOS"
license=('custom')
depends=('webkit2gtk-4.1' 'xorg-xwayland' 'libsecret' 'libnotify' 'gnome-keyring' 'bluez' 'bluez-utils' 'libinput' 'xf86-input-libinput' 'qt6-connectivity' 'qt6-declarative' 'libpulse' 'openssl' 'dotnet-runtime' 'aspnet-runtime' 'avahi' 'wl-clipboard' 'libei' 'libxkbcommon' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugin-pipewire' 'kwin' 'qt5-wayland' 'qt6-wayland' 'gamemode' 'lib32-gamemode' 'mangohud' 'lib32-mangohud')
backup=('etc/daisyos/settings.json')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  [[ -x "$srcdir/airpods-root/usr/lib/daisyos/librepods" ]] || { echo "Missing AirPods companion payload" >&2; return 1; }
  cp -a "$srcdir/airpods-root/." "$pkgdir/"
  if [[ ! -d "$srcdir/gaming-root/usr/local/lib/daisyos" ]]; then
    echo "Missing automatic gaming integration; publish the current release payload first." >&2
    return 1
  fi
  cp -a "$srcdir/gaming-root/." "$pkgdir/"
  if [[ ! -d "$srcdir/fonts-root/usr/share/fonts/daisyos" ]]; then
    echo "Missing system fonts; publish the current release payload first." >&2
    return 1
  fi
  cp -a "$srcdir/fonts-root/." "$pkgdir/"
  if [[ ! -f "$srcdir/plasma-wallpaper-root/usr/share/plasma/wallpapers/org.daisyos.wallpaper/metadata.json" ]]; then
    echo "Missing DaisyOS Plasma wallpaper provider; publish the current release payload first." >&2
    return 1
  fi
  cp -a "$srcdir/plasma-wallpaper-root/." "$pkgdir/"
  if [[ ! -d "$srcdir/window-menus-root/usr/share/daisyos/window-menu-icons" ]]; then
    echo "Missing DaisyOS window menus; publish the current release payload first." >&2
    return 1
  fi
  cp -a "$srcdir/window-menus-root/." "$pkgdir/"
  mkdir -p "$pkgdir/usr/lib/daisyos"
  mkdir -p "$pkgdir/usr/bin"
  mkdir -p "$pkgdir/usr/lib/systemd/user"
  mkdir -p "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  mkdir -p "$pkgdir/usr/share/daisyos/defaults"
  mkdir -p "$pkgdir/etc/daisyos"

  cp -r * "$pkgdir/usr/lib/daisyos/"
  ln -s /usr/lib/daisyos/daisyos-shell "$pkgdir/usr/bin/daisyos-shell"
  ln -s /usr/lib/daisyos/apps/Mail/DaisyOS.Mail "$pkgdir/usr/bin/daisyos-mail"
  ln -s /usr/lib/daisyos/apps/Continuity/DaisyOS.Continuity "$pkgdir/usr/bin/daisyos-continuity"
  cp "$srcdir/daisyos-continuity.service" "$pkgdir/usr/lib/systemd/user/daisyos-continuity.service"
  cp "$srcdir/daisyos-shell.service" "$pkgdir/usr/lib/systemd/user/daisyos-shell.service"
  install -Dm644 "$srcdir/daisyos-gamingd.service" "$pkgdir/usr/lib/systemd/user/daisyos-gamingd.service"
  install -Dm644 "$srcdir/org.daisyos.Gaming1.service" "$pkgdir/usr/share/dbus-1/services/org.daisyos.Gaming1.service"
  ln -sfn ../daisyos-gamingd.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/daisyos-gamingd.service"
  # Background mail check: installed system-wide and enabled for every user (like `systemctl --global enable`).
  cat > "$pkgdir/usr/lib/systemd/user/daisyos-mail-check.service" <<'UNIT'
[Unit]
Description=DaisyOS Mail background check
ConditionPathExists=%h/.local/share/daisyos/mail/accounts.json

[Service]
Type=oneshot
ExecStart=/usr/bin/daisyos-mail --background-check
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=90
UNIT
  cat > "$pkgdir/usr/lib/systemd/user/daisyos-mail-check.timer" <<'UNIT'
[Unit]
Description=Check DaisyOS Mail for new messages

[Timer]
OnStartupSec=1min
OnUnitInactiveSec=3min
AccuracySec=30s

[Install]
WantedBy=timers.target
UNIT
  mkdir -p "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../daisyos-mail-check.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/daisyos-mail-check.timer"
  cp "$srcdir/defaults/settings.json" "$pkgdir/usr/share/daisyos/defaults/settings.json"
  cp "$srcdir/defaults/settings.json" "$pkgdir/etc/daisyos/settings.json"
}
